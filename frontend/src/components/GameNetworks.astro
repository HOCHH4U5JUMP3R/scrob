---
const { token } = Astro.locals;
---

<section id="game-networks" class="space-y-3">
  <div class="space-y-3">
    <details id="psn-details" class="group rounded-2xl border border-zinc-800 bg-zinc-900/70 overflow-hidden">
      <summary class="relative flex items-center gap-3 px-6 py-4 cursor-pointer list-none hover:bg-zinc-900 transition">
        <div class="w-11 h-11 rounded-xl bg-zinc-950 border border-zinc-800 flex items-center justify-center shrink-0" style="color:#003791">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M8.984 2.596v17.547l3.915 1.261V6.688c0-.69.304-1.151.794-.991.636.18.76.814.76 1.505v5.875c2.441 1.193 4.362-.002 4.362-3.152 0-3.237-1.126-4.675-4.438-5.827-1.307-.448-3.728-1.186-5.39-1.502zm4.656 16.241 6.296-2.275c.715-.258.826-.625.246-.818-.586-.192-1.637-.139-2.357.123l-4.205 1.5V14.98l.24-.085s1.201-.42 2.913-.615c1.696-.18 3.785.03 5.437.661 1.848.601 2.04 1.472 1.576 2.072-.465.6-1.622 1.036-1.622 1.036l-8.544 3.107V18.86zM1.807 18.6c-1.9-.545-2.214-1.668-1.352-2.32.801-.586 2.16-1.052 2.16-1.052l5.615-2.013v2.313L4.205 17c-.705.271-.825.632-.239.826.586.195 1.637.15 2.343-.12L8.247 17v2.074c-.12.03-.256.044-.39.073-1.939.331-3.996.196-6.038-.479z"/></svg>
        </div>
        <div class="min-w-0 flex-1 pr-8">
          <div class="flex items-center gap-2 flex-wrap">
            <h3 class="font-bold text-zinc-100">PlayStation Network</h3>
            <span id="psn-badge" class="px-2.5 py-1 rounded-full bg-zinc-800 text-zinc-500 text-[10px] font-black uppercase tracking-wider">Offline</span>
          </div>
          <p id="psn-status" class="text-xs text-zinc-500 mt-0.5">Checking connection…</p>
          <p id="psn-sync-status" class="text-[10px] text-zinc-600 mt-0.5">Last synced: —</p>
        </div>
        <span class="text-zinc-500 transition-transform group-open:rotate-180">⌄</span>
        <button id="psn-disconnect-btn" type="button" class="hidden absolute right-14 top-4 px-2.5 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900 text-zinc-500 text-[11px] font-bold hover:border-zinc-600 hover:text-zinc-200 transition z-10">Disconnect</button>
      </summary>
      <div class="border-t border-zinc-800 px-6 py-5">
        <div id="psn-connect-form" class="space-y-3">
          <button id="psn-connect-btn" type="button" class="w-full px-4 py-3 rounded-xl bg-zinc-100 text-zinc-950 font-black text-sm hover:bg-white disabled:opacity-50">Connect with PlayStation</button>
          <div id="psn-browser-panel" class="hidden rounded-xl border border-zinc-800 bg-zinc-950/60 p-4 space-y-3">
            <p class="text-sm font-semibold text-zinc-200">Sign in to PlayStation</p>
            <ol class="text-xs text-zinc-500 space-y-1.5 list-decimal list-inside">
              <li>Open PlayStation and sign in normally.</li>
              <li>Drag the <a id="psn-bookmarklet" href="#" class="text-sky-400 hover:text-sky-300 underline font-semibold">Scrob PSN Login</a> link to your bookmarks bar.</li>
              <li>While still on a PlayStation/Sony page, click that bookmark once.</li>
            </ol>
            <div class="flex flex-wrap gap-2">
              <a id="psn-open-btn" href="https://www.playstation.com/" target="_blank" rel="noopener noreferrer" class="px-3 py-2 rounded-lg bg-zinc-800 border border-zinc-700 text-zinc-200 text-xs font-bold hover:bg-zinc-700">Open PlayStation</a>
              <button id="psn-copy-bookmarklet" type="button" class="px-3 py-2 rounded-lg bg-zinc-800 border border-zinc-700 text-zinc-200 text-xs font-bold hover:bg-zinc-700">Copy bookmarklet</button>
            </div>
            <p id="psn-browser-status" class="text-[11px] text-zinc-500">Waiting for your PlayStation login…</p>
          </div>
        </div>
        <div id="psn-connected-actions" class="hidden flex items-center gap-2 flex-wrap">
          <button id="psn-sync-btn" type="button" class="px-4 py-2.5 rounded-xl bg-sky-500 text-white font-black text-sm hover:bg-sky-400 disabled:opacity-50">Sync games</button>
          <label class="flex items-center gap-2 text-xs text-zinc-500">Auto sync
            <select id="psn-auto-sync" class="bg-zinc-950 border border-zinc-800 rounded-lg px-2 py-1 text-xs text-zinc-300">
              <option value="">Off</option><option value="0.25">Every 15 minutes</option><option value="0.5">Every 30 minutes</option><option value="1">Every hour</option><option value="3">Every 3 hours</option><option value="6">Every 6 hours</option><option value="12">Every 12 hours</option><option value="24">Every 24 hours</option>
            </select>
          </label>
        </div>
        <p id="psn-message" class="hidden mt-3 text-xs"></p>
      </div>
    </details>

    <details id="xbox-details" class="group rounded-2xl border border-zinc-800 bg-zinc-900/70 overflow-hidden">
      <summary class="relative flex items-center gap-3 px-6 py-4 cursor-pointer list-none hover:bg-zinc-900 transition">
        <div class="w-11 h-11 rounded-xl bg-zinc-950 border border-zinc-800 flex items-center justify-center shrink-0" style="color:#107C10">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M4.102 21.033A11.95 11.95 0 0 0 12 24a11.96 11.96 0 0 0 7.902-2.967c1.877-1.912-4.316-8.709-7.902-11.417-3.582 2.708-9.779 9.505-7.898 11.417m11.16-14.406c2.5 2.961 7.484 10.313 6.076 12.912A11.94 11.94 0 0 0 24 12.004a11.95 11.95 0 0 0-3.57-8.536s-.027-.022-.082-.042c-.592 0-1.985.434-4.805 3.246M3.654 3.426c-.057.02-.082.042-.086.042A11.96 11.96 0 0 0 0 12.004c0 2.854.998 5.473 2.661 7.533-1.401-2.605 3.579-9.951 6.08-12.91-2.82-2.813-4.216-3.245-4.806-3.245a.7.7 0 0 0-.281.046zM12 3.551S9.055 1.828 6.755 1.746c-.903-.033-1.454.295-1.521.339C14.946 1.828 12 3.545 12 3.545z"/></svg>
        </div>
        <div class="min-w-0 flex-1 pr-8">
          <div class="flex items-center gap-2 flex-wrap"><h3 class="font-bold text-zinc-100">Xbox Network</h3><span id="xbox-badge" class="px-2.5 py-1 rounded-full bg-zinc-800 text-zinc-500 text-[10px] font-black uppercase tracking-wider">Offline</span></div>
          <p id="xbox-status" class="text-xs text-zinc-500 mt-0.5">Checking connection…</p>
          <p id="xbox-sync-status" class="text-[10px] text-zinc-600 mt-0.5">Last synced: —</p>
        </div>
        <span class="text-zinc-500 transition-transform group-open:rotate-180">⌄</span>
        <button id="xbox-disconnect-btn" type="button" class="hidden absolute right-14 top-4 px-2.5 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900 text-zinc-500 text-[11px] font-bold hover:border-zinc-600 hover:text-zinc-200 transition z-10">Disconnect</button>
      </summary>
      <div class="border-t border-zinc-800 px-6 py-5">
        <div id="xbox-connect-form" class="space-y-3">
          <button id="xbox-connect-btn" type="button" class="w-full px-4 py-3 rounded-xl bg-zinc-100 text-zinc-950 font-black text-sm hover:bg-white disabled:opacity-50">Connect Xbox</button>
          <div id="xbox-complete-form" class="hidden space-y-2">
            <p class="text-xs text-zinc-500">After signing in, Microsoft redirects to localhost. Copy the complete URL from the browser address bar and paste it here.</p>
            <input id="xbox-code" type="text" autocomplete="off" placeholder="Paste the Microsoft redirect URL or authorization code" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-sm text-zinc-100 focus:outline-none focus:ring-2 focus:ring-sky-500" />
            <button id="xbox-complete-btn" type="button" class="w-full px-4 py-3 rounded-xl bg-sky-500 text-white font-black text-sm hover:bg-sky-400 disabled:opacity-50">Complete Xbox connection</button>
          </div>
        </div>
        <div id="xbox-connected-actions" class="hidden items-center gap-2 flex-wrap">
          <button id="xbox-sync-btn" type="button" class="px-4 py-2.5 rounded-xl bg-sky-500 text-white font-black text-sm hover:bg-sky-400 disabled:opacity-50">Sync games</button>
          <label class="flex items-center gap-2 text-xs text-zinc-500">Auto sync
            <select id="xbox-auto-sync" class="bg-zinc-950 border border-zinc-800 rounded-lg px-2 py-1 text-xs text-zinc-300">
              <option value="">Off</option><option value="0.25">Every 15 minutes</option><option value="0.5">Every 30 minutes</option><option value="1">Every hour</option><option value="3">Every 3 hours</option><option value="6">Every 6 hours</option><option value="12">Every 12 hours</option><option value="24">Every 24 hours</option>
            </select>
          </label>
        </div>
        <p id="xbox-message" class="hidden mt-3 text-xs"></p>
      </div>
    </details>

    <details class="group rounded-2xl border border-zinc-800 bg-zinc-900/40 overflow-hidden opacity-80">
      <summary class="flex items-center gap-3 px-6 py-4 cursor-pointer list-none">
        <div class="w-11 h-11 rounded-xl bg-zinc-950 border border-zinc-800 flex items-center justify-center text-xl">🎮</div>
        <div class="min-w-0 flex-1"><div class="flex items-center gap-2"><h3 class="font-bold text-zinc-200">Steam</h3><span class="px-2.5 py-1 rounded-full bg-zinc-800 text-zinc-600 text-[10px] font-black uppercase tracking-wider">Soon</span></div><p class="text-xs text-zinc-500 mt-0.5">Steam integration</p></div>
        <span class="text-zinc-500">⌄</span>
      </summary>
    </details>
  </div>
</section>

<style>
  details > summary::-webkit-details-marker { display: none; }
  details > summary::marker { display: none; }
</style>

<script define:vars={{ token }}>
  const api = (path, options = {}) => fetch("/api/proxy" + path, {
    ...options,
    headers: {
      Authorization: "Bearer " + token,
      "Content-Type": "application/json",
      ...(options.headers || {}),
    },
  });

  const badge = document.getElementById("psn-badge");
  const status = document.getElementById("psn-status");
  const form = document.getElementById("psn-connect-form");
  const actions = document.getElementById("psn-connected-actions");
  const message = document.getElementById("psn-message");
  const syncStatus = document.getElementById("psn-sync-status");
  const disconnectBtn = document.getElementById("psn-disconnect-btn");
  const psnLastSyncHeader = document.getElementById("psn-last-sync-header");
  const xboxBadge = document.getElementById("xbox-badge");
  const xboxStatus = document.getElementById("xbox-status");
  const xboxForm = document.getElementById("xbox-connect-form");
  const xboxActions = document.getElementById("xbox-connected-actions");
  const xboxMessage = document.getElementById("xbox-message");
  const xboxSyncStatus = document.getElementById("xbox-sync-status");
  const xboxDisconnectBtn = document.getElementById("xbox-disconnect-btn");
  const xboxLastSyncHeader = document.getElementById("xbox-last-sync-header");
  const xboxCompleteForm = document.getElementById("xbox-complete-form");
  const xboxCode = document.getElementById("xbox-code");
  const psnAutoSync = document.getElementById("psn-auto-sync");
  const xboxAutoSync = document.getElementById("xbox-auto-sync");
  const steamBadge = document.getElementById("steam-badge");
  const steamStatus = document.getElementById("steam-status");
  const steamForm = document.getElementById("steam-connect-form");
  const steamActions = document.getElementById("steam-connected-actions");
  const steamMessage = document.getElementById("steam-message");
  const steamSyncStatus = document.getElementById("steam-sync-status");
  const steamDisconnectBtn = document.getElementById("steam-disconnect-btn");
  const steamLastSyncHeader = document.getElementById("steam-last-sync-header");
  const steamAutoSync = document.getElementById("steam-auto-sync");
  const steamCompleteForm = document.getElementById("steam-complete-form");
  const steamRedirectUrl = document.getElementById("steam-redirect-url");
  document.querySelectorAll("#game-networks details").forEach((details) => {
    details.addEventListener("toggle", () => {
      const icon = details.querySelector("[data-chevron]");
      if (icon) icon.textContent = details.open ? "⌃" : "⌄";
    });
  });

  const setAutoSync = async (network, value, select) => {
    try {
      const res = await api("/" + network + "/auto-sync", {
        method: "POST",
        body: JSON.stringify({ interval: value ? Number(value) : null }),
      });
      if (!res.ok) throw new Error(await readError(res, "Could not update auto sync."));
      select.value = value || "";
    } catch (error) {
      console.error(error);
    }
  };

  const setSteamMessage = (value, error = false) => {
    steamMessage.textContent = value;
    steamMessage.className = "mt-3 text-xs " + (error ? "text-red-400" : "text-emerald-400");
    steamMessage.classList.remove("hidden");
  };

  const refreshSteamStatus = async () => {
    try {
      const res = await api("/steam/status");
      if (!res.ok) throw new Error(await readError(res, "Could not read Steam connection status."));
      const data = await res.json();
      if (!data.connected) {
        steamLastSyncHeader.textContent = "";
        steamBadge.textContent = "Offline";
        steamStatus.textContent = "Not connected";
        steamForm.classList.remove("hidden");
        steamActions.classList.add("hidden");
        steamDisconnectBtn.classList.add("hidden");
        return;
      }
      steamBadge.textContent = "Connected";
      steamBadge.className = "px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-[10px] font-black uppercase tracking-wider";
      steamStatus.textContent = data.persona_name ? "Connected as " + data.persona_name : "Connected";
      steamForm.classList.add("hidden");
      steamActions.classList.remove("hidden");
      steamDisconnectBtn.classList.remove("hidden");
      steamAutoSync.value = data.auto_sync_interval != null ? String(data.auto_sync_interval) : "";
      if (data.last_sync_error) {
        steamSyncStatus.textContent = "Last sync failed: " + data.last_sync_error;
        steamSyncStatus.className = "px-6 pb-5 text-[10px] text-red-400 mt-1";
      } else if (data.last_sync_at) {
        steamSyncStatus.textContent = "Last synced: " + new Date(data.last_sync_at).toLocaleString("de-DE") + " · " + (data.last_sync_count ?? 0) + " games";
        steamLastSyncHeader.textContent = "Last synced: " + new Date(data.last_sync_at).toLocaleString("de-DE");
      } else {
        steamSyncStatus.textContent = "Not synced yet.";
      }
    } catch (error) {
      steamStatus.textContent = error?.message || "Could not check connection";
    }
  };

  document.getElementById("steam-connect-btn")?.addEventListener("click", async () => {
    const button = document.getElementById("steam-connect-btn");
    button.disabled = true;
    setSteamMessage("Opening Steam sign-in…");
    try {
      const res = await api("/steam/authorize", { method: "POST", body: JSON.stringify({}) });
      if (!res.ok) throw new Error(await readError(res, "Could not start Steam authentication."));
      const data = await res.json();
      window.open(data.authorization_url, "_blank", "noopener,noreferrer");
      steamCompleteForm.classList.remove("hidden");
      setSteamMessage("Sign in in the new tab. If Steam redirects to an unreachable page, paste that complete URL here.");
    } catch (error) {
      setSteamMessage(error?.message || "Steam authentication failed.", true);
    } finally {
      button.disabled = false;
    }
  });

  document.getElementById("steam-complete-btn")?.addEventListener("click", async () => {
    const button = document.getElementById("steam-complete-btn");
    const value = steamRedirectUrl.value.trim();
    if (!value) {
      setSteamMessage("Paste the complete Steam redirect URL first.", true);
      return;
    }
    button.disabled = true;
    setSteamMessage("Completing Steam authentication…");
    try {
      const res = await api("/steam/complete", {
        method: "POST",
        body: JSON.stringify({ redirect_url: value }),
      });
      if (!res.ok) throw new Error(await readError(res, "Steam authentication failed."));
      steamRedirectUrl.value = "";
      steamCompleteForm.classList.add("hidden");
      setSteamMessage("Steam connected. You can now sync your games.");
      await refreshSteamStatus();
    } catch (error) {
      setSteamMessage(error?.message || "Steam authentication failed.", true);
    } finally {
      button.disabled = false;
    }
  });

  steamAutoSync?.addEventListener("change", () => setAutoSync("steam", steamAutoSync.value, steamAutoSync));

  document.getElementById("steam-sync-btn")?.addEventListener("click", async () => {
    const button = document.getElementById("steam-sync-btn");
    button.disabled = true;
    setSteamMessage("Syncing your Steam library…");
    try {
      const res = await api("/steam/sync", { method: "POST" });
      if (!res.ok) throw new Error(await readError(res, "Steam sync failed."));
      const data = await res.json();
      setSteamMessage("Synced " + data.games_imported + " games.");
      await refreshSteamStatus();
      setTimeout(() => location.reload(), 500);
    } catch (error) {
      setSteamMessage(error?.message || "Steam sync failed.", true);
      await refreshSteamStatus();
    } finally {
      button.disabled = false;
    }
  });

  steamDisconnectBtn?.addEventListener("click", async () => {
    const res = await api("/steam/disconnect", { method: "DELETE" });
    if (!res.ok) {
      setSteamMessage(await readError(res, "Could not disconnect Steam."), true);
      return;
    }
    location.reload();
  });

  const setXboxMessage = (value, error = false) => {
    xboxMessage.textContent = value;
    xboxMessage.className = "mt-3 text-xs " + (error ? "text-red-400" : "text-emerald-400");
    xboxMessage.classList.remove("hidden");
  };

  const refreshXboxStatus = async () => {
    try {
      const res = await api("/xbox/status");
      if (!res.ok) throw new Error(await readError(res, "Could not read Xbox connection status."));
      const data = await res.json();

      if (!data.connected) {
        xboxLastSyncHeader.textContent = "";
        xboxBadge.textContent = "Ready";
        xboxBadge.className = "px-2.5 py-1 rounded-full bg-zinc-800 text-zinc-500 text-[10px] font-black uppercase tracking-wider";
        xboxStatus.textContent = "Not connected";
        xboxForm.classList.remove("hidden");
        xboxActions.classList.add("hidden");
        xboxDisconnectBtn?.classList.add("hidden");
        return;
      }

      xboxBadge.textContent = "Connected";
      xboxBadge.className = "px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-[10px] font-black uppercase tracking-wider";
      xboxStatus.textContent = data.gamertag ? "Connected as " + data.gamertag : "Connected";
      xboxForm.classList.add("hidden");
      xboxActions.classList.remove("hidden");
      xboxDisconnectBtn?.classList.remove("hidden");
      if (xboxAutoSync) xboxAutoSync.value = data.auto_sync_interval != null ? String(data.auto_sync_interval) : "";

      if (data.last_sync_error) {
        xboxSyncStatus.textContent = "Last sync failed: " + data.last_sync_error;
        xboxSyncStatus.className = "text-[11px] text-red-400 mt-3";
      } else if (data.last_sync_at) {
        xboxSyncStatus.textContent = "Last synced: " + new Date(data.last_sync_at).toLocaleString("de-DE") + " · " + (data.last_sync_count ?? 0) + " games";
        xboxLastSyncHeader.textContent = "Last synced: " + new Date(data.last_sync_at).toLocaleString("de-DE");
        xboxSyncStatus.className = "text-[11px] text-zinc-600 mt-3";
      } else {
        xboxSyncStatus.textContent = "Not synced yet.";
      }
    } catch (error) {
      xboxBadge.textContent = "Error";
      xboxBadge.className = "px-2.5 py-1 rounded-full bg-red-500/10 text-red-400 text-[10px] font-black uppercase tracking-wider";
      xboxStatus.textContent = error?.message || "Could not check connection";
    }
  };

  psnAutoSync?.addEventListener("change", () => setAutoSync("psn", psnAutoSync.value, psnAutoSync));
  xboxAutoSync?.addEventListener("change", () => setAutoSync("xbox", xboxAutoSync.value, xboxAutoSync));

  document.getElementById("xbox-connect-btn")?.addEventListener("click", async () => {
    const button = document.getElementById("xbox-connect-btn");
    button.disabled = true;
    setXboxMessage("Opening Microsoft sign-in…");

    try {
      const res = await api("/xbox/authorize");
      if (!res.ok) throw new Error(await readError(res, "Could not start Xbox authentication."));
      const data = await res.json();
      window.open(data.authorization_url, "_blank", "noopener,noreferrer");
      xboxCompleteForm.classList.remove("hidden");
      setXboxMessage("Sign in in the new tab, then paste the redirect URL here.");
    } catch (error) {
      setXboxMessage(error?.message || "Xbox authentication failed.", true);
    } finally {
      button.disabled = false;
    }
  });

  document.getElementById("xbox-complete-btn")?.addEventListener("click", async () => {
    const button = document.getElementById("xbox-complete-btn");
    const value = xboxCode.value.trim();
    if (!value) {
      setXboxMessage("Paste the Microsoft redirect URL or authorization code first.", true);
      return;
    }

    button.disabled = true;
    setXboxMessage("Completing Xbox authentication…");

    try {
      const res = await api("/xbox/complete", {
        method: "POST",
        body: JSON.stringify({ code_or_url: value }),
      });
      if (!res.ok) throw new Error(await readError(res, "Xbox authentication failed."));
      xboxCode.value = "";
      xboxCompleteForm.classList.add("hidden");
      setXboxMessage("Xbox connected. You can now sync your games.");
      await refreshXboxStatus();
    } catch (error) {
      setXboxMessage(error?.message || "Xbox authentication failed.", true);
    } finally {
      button.disabled = false;
    }
  });

  document.getElementById("xbox-sync-btn")?.addEventListener("click", async () => {
    const button = document.getElementById("xbox-sync-btn");
    button.disabled = true;
    setXboxMessage("Syncing your Xbox library…");

    try {
      const res = await api("/xbox/sync", { method: "POST" });
      if (!res.ok) throw new Error(await readError(res, "Xbox sync failed."));
      const data = await res.json();
      setXboxMessage("Synced " + data.games_imported + " games.");
      await refreshXboxStatus();
      setTimeout(() => location.reload(), 500);
    } catch (error) {
      setXboxMessage(error?.message || "Xbox sync failed.", true);
      await refreshXboxStatus();
    } finally {
      button.disabled = false;
    }
  });

  document.getElementById("xbox-disconnect-btn")?.addEventListener("click", async (event) => {
    event.preventDefault();
    event.stopPropagation();
    const res = await api("/xbox/disconnect", { method: "DELETE" });
    if (!res.ok) {
      setXboxMessage(await readError(res, "Could not disconnect Xbox."), true);
      return;
    }
    location.reload();
  });



  const setMessage = (value, error = false) => {
    message.textContent = value;
    message.className = "mt-3 text-xs " + (error ? "text-red-400" : "text-emerald-400");
    message.classList.remove("hidden");
  };

  const readError = async (res, fallback) => {
    try {
      const data = await res.json();
      return data.detail || fallback;
    } catch {
      return fallback;
    }
  };

  async function refreshStatus() {
    try {
      const res = await api("/psn/status");
      if (!res.ok) throw new Error(await readError(res, "Could not read PlayStation connection status."));
      const data = await res.json();

      if (!data.connected) {
        psnLastSyncHeader.textContent = "";
        badge.textContent = "Offline";
        badge.className = "px-2.5 py-1 rounded-full bg-zinc-800 text-zinc-500 text-[10px] font-black uppercase tracking-wider";
        status.textContent = "Not connected";
        form.classList.remove("hidden");
        actions.classList.add("hidden");
        disconnectBtn?.classList.add("hidden");
        return;
      }

      badge.textContent = "Connected";
      badge.className = "px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-[10px] font-black uppercase tracking-wider";
      status.textContent = data.online_id ? "Connected as " + data.online_id : "Connected";
      form.classList.add("hidden");
      actions.classList.remove("hidden");
      disconnectBtn?.classList.remove("hidden");
      if (psnAutoSync) psnAutoSync.value = data.auto_sync_interval != null ? String(data.auto_sync_interval) : "";

      if (data.last_sync_error) {
        syncStatus.textContent = "Last sync failed: " + data.last_sync_error;
        syncStatus.className = "text-[11px] text-red-400 mt-3";
      } else if (data.last_sync_at) {
        syncStatus.textContent = "Last synced: " + new Date(data.last_sync_at).toLocaleString("de-DE") + " · " + (data.last_sync_count ?? 0) + " games";
        psnLastSyncHeader.textContent = "Last synced: " + new Date(data.last_sync_at).toLocaleString("de-DE");
        syncStatus.className = "text-[11px] text-zinc-600 mt-3";
      } else {
        syncStatus.textContent = "Not synced yet.";
      }
    } catch (error) {
      badge.textContent = "Error";
      badge.className = "px-2.5 py-1 rounded-full bg-red-500/10 text-red-400 text-[10px] font-black uppercase tracking-wider";
      status.textContent = error?.message || "Could not check connection";
    }
  }

  let psnBrowserState = "";

  const buildPsnBookmarklet = (state) => {
    const target = window.location.origin + "/api/proxy/psn/browser/complete";
    const code = [
      "(async()=>{",
      "const m=document.cookie.match(/(?:^|;\\s*)npsso=([^;]+)/);",
      'if(!m){alert("No PSN session cookie found. Please sign in to PlayStation first.");return;}',
      "try{",
      "await fetch(" + JSON.stringify(target) + ",{method:\"POST\",mode:\"no-cors\",headers:{\"Content-Type\":\"text/plain\"},body:" + JSON.stringify(state) + "+\"|\"+location.hostname+\"|\"+decodeURIComponent(m[1])});",
      'alert("Scrob: PlayStation login sent. Return to Scrob.");',
      '}catch(e){alert("Scrob: Could not send the PlayStation login.");}',
      "})()",
    ].join("");
    return "javascript:" + encodeURIComponent(code);
  };

  const startPsnBrowserLogin = async () => {
    const button = document.getElementById("psn-connect-btn");
    const panel = document.getElementById("psn-browser-panel");
    const statusEl = document.getElementById("psn-browser-status");
    const bookmarklet = document.getElementById("psn-bookmarklet");
    const openBtn = document.getElementById("psn-open-btn");
    const copyBtn = document.getElementById("psn-copy-bookmarklet");
    if (!button || !panel || !statusEl || !bookmarklet || !openBtn || !copyBtn) return;

    button.disabled = true;
    setMessage("Preparing PlayStation sign-in…");
    try {
      const res = await api("/psn/browser/start", { method: "POST" });
      if (!res.ok) throw new Error(await readError(res, "Could not start PlayStation authentication."));
      const data = await res.json();
      psnBrowserState = data.state;
      const href = buildPsnBookmarklet(psnBrowserState);
      bookmarklet.href = href;
      copyBtn.onclick = async () => {
        await navigator.clipboard.writeText(href);
        copyBtn.textContent = "Copied";
        setTimeout(() => { copyBtn.textContent = "Copy bookmarklet"; }, 1500);
      };
      openBtn.href = data.playstation_url;
      panel.classList.remove("hidden");
      statusEl.textContent = "Waiting for the PlayStation session…";
      window.open(data.playstation_url, "_blank", "noopener,noreferrer");
      const deadline = Date.now() + (data.expires_in * 1000);
      while (Date.now() < deadline && psnBrowserState) {
        await new Promise(resolve => setTimeout(resolve, 1000));
        const poll = await api("/psn/browser/status?state=" + encodeURIComponent(psnBrowserState));
        if (!poll.ok) throw new Error(await readError(poll, "PlayStation login failed."));
        const result = await poll.json();
        if (result.status === "completed") {
          psnBrowserState = "";
          statusEl.textContent = "Connected as " + result.online_id + ".";
          setMessage("PlayStation connected. You can now sync your games.");
          await refreshStatus();
          return;
        }
      }
      throw new Error("PlayStation login timed out. Start the connection again.");
    } catch (error) {
      setMessage(error?.message || "PlayStation authentication failed.", true);
    } finally {
      button.disabled = false;
    }
  };

  document.getElementById("psn-connect-btn")?.addEventListener("click", startPsnBrowserLogin);
  document.getElementById("psn-sync-btn")?.addEventListener("click", async () => {
    const button = document.getElementById("psn-sync-btn");
    button.disabled = true;
    setMessage("Syncing your PlayStation library…");

    try {
      const res = await api("/psn/sync", { method: "POST" });
      if (!res.ok) throw new Error(await readError(res, "PlayStation sync failed."));
      const data = await res.json();
      setMessage("Synced " + data.games_imported + " games.");
      await refreshStatus();
      setTimeout(() => location.reload(), 500);
    } catch (error) {
      setMessage(error?.message || "PlayStation sync failed.", true);
      await refreshStatus();
    } finally {
      button.disabled = false;
    }
  });

  document.getElementById("psn-disconnect-btn")?.addEventListener("click", async (event) => {
    event.preventDefault();
    event.stopPropagation();
    const res = await api("/psn/disconnect", { method: "DELETE" });
    if (!res.ok) {
      setMessage(await readError(res, "Could not disconnect PlayStation."), true);
      return;
    }
    location.reload();
  });

  refreshStatus();
  refreshXboxStatus();
  const initializeGameNetworks = () => {
    void refreshStatus();
    void refreshXboxStatus();
    void refreshSteamStatus();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeGameNetworks, { once: true });
  } else {
    initializeGameNetworks();
  }
</script>
