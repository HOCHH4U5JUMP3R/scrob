---
const { token } = Astro.locals;
---

<section id="game-networks" class="space-y-4">
  <div>
    <h2 class="section-headline border-b border-zinc-800 pb-2">Game Networks</h2>
    <p class="text-sm text-zinc-500 mt-2">
      Connect gaming services to import your games, playtime and achievements into Scrob.
    </p>
  </div>

  <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4">
    <article class="rounded-2xl border border-zinc-800 bg-zinc-900/70 p-5">
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-zinc-950 border border-zinc-800 flex items-center justify-center text-xl">◉</div>
          <div>
            <h3 class="font-bold text-zinc-100">PlayStation Network</h3>
            <p id="psn-status" class="text-xs text-zinc-500 mt-0.5">Checking connection…</p>
          </div>
        </div>
        <span id="psn-badge" class="px-2.5 py-1 rounded-full bg-zinc-800 text-zinc-500 text-[10px] font-black uppercase tracking-wider">Offline</span>
      </div>

      <p class="text-sm text-zinc-500 mt-4">
        Import PS4/PS5 playtime and last-played data plus trophy progress. PS3 and Vita trophy titles are included where PSN provides them.
      </p>

      <div id="psn-connect-form" class="mt-4 space-y-3">
        <button id="psn-connect-btn" type="button"
          class="w-full px-4 py-3 rounded-xl bg-zinc-100 text-zinc-950 font-black text-sm hover:bg-white disabled:opacity-50">
          Connect with PlayStation
        </button>
        <div id="psn-browser-panel" class="hidden rounded-xl border border-zinc-800 bg-zinc-950/60 p-4 space-y-3">
          <p class="text-sm font-semibold text-zinc-200">Sign in to PlayStation</p>
          <ol class="text-xs text-zinc-500 space-y-1.5 list-decimal list-inside">
            <li>Open PlayStation and sign in normally.</li>
            <li>Drag the <a id="psn-bookmarklet" href="#" class="text-sky-400 hover:text-sky-300 underline font-semibold">Scrob PSN Login</a> link to your bookmarks bar.</li>
            <li>While still on a PlayStation/Sony page, click that bookmark once.</li>
          </ol>
          <div class="flex flex-wrap gap-2">
            <a id="psn-open-btn" href="https://www.playstation.com/" target="_blank" rel="noopener noreferrer" class="px-3 py-2 rounded-lg bg-zinc-800 border border-zinc-700 text-zinc-200 text-xs font-bold hover:bg-zinc-700">Open PlayStation</a>
            <button id="psn-copy-bookmarklet" type="button" class="px-3 py-2 rounded-lg bg-zinc-800 border border-zinc-700 text-zinc-200 text-xs font-bold hover:bg-zinc-700">Copy bookmarklet</button>
          </div>
          <p id="psn-browser-status" class="text-[11px] text-zinc-500">Waiting for your PlayStation login…</p>
          <p class="text-[10px] text-zinc-600">Scrob never receives your PSN password. The bookmarklet only reads the Sony session cookie and sends it through a one-time login state.</p>
        </div>
      </div>
      <div id="psn-connected-actions" class="hidden mt-4 flex items-center gap-2 flex-wrap">
        <button id="psn-sync-btn" type="button"
          class="px-4 py-2.5 rounded-xl bg-sky-500 text-white font-black text-sm hover:bg-sky-400 disabled:opacity-50">
          Sync games
        </button>
<label class="flex items-center gap-2 text-xs text-zinc-500">
          Auto sync
          <select id="psn-auto-sync" class="bg-zinc-950 border border-zinc-800 rounded-lg px-2 py-1 text-xs text-zinc-300">
            <option value="">Off</option><option value="0.25">Every 15 minutes</option><option value="0.5">Every 30 minutes</option><option value="1">Every hour</option><option value="3">Every 3 hours</option><option value="6">Every 6 hours</option><option value="12">Every 12 hours</option><option value="24">Every 24 hours</option>
          </select>
        </label>
        <button id="psn-disconnect-btn" type="button"
          class="px-4 py-2.5 rounded-xl border border-zinc-700 text-zinc-400 font-bold text-sm hover:text-white">
          Disconnect
        </button>
      </div>
        

      <p id="psn-message" class="hidden mt-3 text-xs"></p>
      <p id="psn-sync-status" class="text-[11px] text-zinc-600 mt-3"></p>
      <p class="text-[11px] text-zinc-600 mt-4">
        Scrob uses the Sony browser session to obtain and persist the PSN refresh token. Your PSN password never reaches Scrob.
      </p>
    </article>

    <article class="rounded-2xl border border-zinc-800 bg-zinc-900/70 p-5">
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-zinc-950 border border-zinc-800 flex items-center justify-center text-xl">X</div>
          <div>
            <h3 class="font-bold text-zinc-100">Xbox Network</h3>
            <p id="xbox-status" class="text-xs text-zinc-500 mt-0.5">Checking connection…</p>
          </div>
        </div>
        <span id="xbox-badge" class="px-2.5 py-1 rounded-full bg-zinc-800 text-zinc-500 text-[10px] font-black uppercase tracking-wider">Offline</span>
      </div>

      <p class="text-sm text-zinc-500 mt-4">
        Connect your Microsoft account to import Xbox game history, playtime and achievement progress.
      </p>

      <div id="xbox-connect-form" class="mt-4 space-y-3">
        <button id="xbox-connect-btn" type="button"
          class="w-full px-4 py-3 rounded-xl bg-zinc-100 text-zinc-950 font-black text-sm hover:bg-white disabled:opacity-50">
          Connect Xbox
        </button>
        <div id="xbox-complete-form" class="hidden space-y-2">
          <p class="text-xs text-zinc-500">
            After signing in, Microsoft redirects to localhost. Copy the complete URL from the browser address bar and paste it here.
          </p>
          <input id="xbox-code" type="text" autocomplete="off"
            placeholder="Paste the Microsoft redirect URL or authorization code"
            class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-sm text-zinc-100 focus:outline-none focus:ring-2 focus:ring-sky-500" />
          <button id="xbox-complete-btn" type="button"
            class="w-full px-4 py-3 rounded-xl bg-sky-500 text-white font-black text-sm hover:bg-sky-400 disabled:opacity-50">
            Complete Xbox connection
          </button>
        </div>
      </div>

      <div id="xbox-connected-actions" class="hidden mt-4 flex items-center gap-2 flex-wrap">
        <button id="xbox-sync-btn" type="button"
          class="px-4 py-2.5 rounded-xl bg-sky-500 text-white font-black text-sm hover:bg-sky-400 disabled:opacity-50">
          Sync games
        </button>
<label class="flex items-center gap-2 text-xs text-zinc-500">
          Auto sync
          <select id="xbox-auto-sync" class="bg-zinc-950 border border-zinc-800 rounded-lg px-2 py-1 text-xs text-zinc-300">
            <option value="">Off</option><option value="0.25">Every 15 minutes</option><option value="0.5">Every 30 minutes</option><option value="1">Every hour</option><option value="3">Every 3 hours</option><option value="6">Every 6 hours</option><option value="12">Every 12 hours</option><option value="24">Every 24 hours</option>
          </select>
        </label>
        <button id="xbox-disconnect-btn" type="button"
          class="px-4 py-2.5 rounded-xl border border-zinc-700 text-zinc-400 font-bold text-sm hover:text-white">
          Disconnect
        </button>
      </div>
        

      <p id="xbox-message" class="hidden mt-3 text-xs"></p>
      <p id="xbox-sync-status" class="text-[11px] text-zinc-600 mt-3"></p>
      <p class="text-[11px] text-zinc-600 mt-4">
        No Azure or Entra setup is required. Sign in with Microsoft and Scrob stores the OAuth token for future syncs.
      </p>
    </article>

    {[

      ["Steam", "Steam library and playtime integration"],
      ["Nintendo", "Nintendo game network integration"],
    ].map(([name, description]) => (
      <article class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-5 opacity-80">
        <div class="flex items-start justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-xl bg-zinc-950 border border-zinc-800 flex items-center justify-center text-xl">🎮</div>
            <div>
              <h3 class="font-bold text-zinc-200">{name}</h3>
              <p class="text-xs text-zinc-500 mt-0.5">{description}</p>
            </div>
          </div>
          <span class="px-2.5 py-1 rounded-full bg-zinc-800 text-zinc-600 text-[10px] font-black uppercase tracking-wider">Soon</span>
        </div>
      </article>
    ))}
  </div>
</section>

<script define:vars={{ token }}>
  const api = (path, options = {}) => fetch("/api/proxy" + path, {
    ...options,
    headers: {
      Authorization: "Bearer " + token,
      "Content-Type": "application/json",
      ...(options.headers || {}),
    },
  });

  const badge = document.getElementById("psn-badge");
  const status = document.getElementById("psn-status");
  const form = document.getElementById("psn-connect-form");
  const actions = document.getElementById("psn-connected-actions");
  const message = document.getElementById("psn-message");
  const syncStatus = document.getElementById("psn-sync-status");
  const xboxBadge = document.getElementById("xbox-badge");
  const xboxStatus = document.getElementById("xbox-status");
  const xboxForm = document.getElementById("xbox-connect-form");
  const xboxActions = document.getElementById("xbox-connected-actions");
  const xboxMessage = document.getElementById("xbox-message");
  const xboxSyncStatus = document.getElementById("xbox-sync-status");
  const xboxCompleteForm = document.getElementById("xbox-complete-form");
  const xboxCode = document.getElementById("xbox-code");
  const psnAutoSync = document.getElementById("psn-auto-sync");
  const xboxAutoSync = document.getElementById("xbox-auto-sync");

  const setAutoSync = async (network, value, select) => {
    try {
      const res = await api("/" + network + "/auto-sync", {
        method: "POST",
        body: JSON.stringify({ interval: value ? Number(value) : null }),
      });
      if (!res.ok) throw new Error(await readError(res, "Could not update auto sync."));
      select.value = value || "";
    } catch (error) {
      console.error(error);
    }
  };

  const setXboxMessage = (value, error = false) => {
    xboxMessage.textContent = value;
    xboxMessage.className = "mt-3 text-xs " + (error ? "text-red-400" : "text-emerald-400");
    xboxMessage.classList.remove("hidden");
  };

  const refreshXboxStatus = async () => {
    try {
      const res = await api("/xbox/status");
      if (!res.ok) throw new Error(await readError(res, "Could not read Xbox connection status."));
      const data = await res.json();

      if (!data.connected) {
        xboxBadge.textContent = "Ready";
        xboxBadge.className = "px-2.5 py-1 rounded-full bg-zinc-800 text-zinc-500 text-[10px] font-black uppercase tracking-wider";
        xboxStatus.textContent = "Not connected";
        xboxForm.classList.remove("hidden");
        xboxActions.classList.add("hidden");
        return;
      }

      xboxBadge.textContent = "Connected";
      xboxBadge.className = "px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-[10px] font-black uppercase tracking-wider";
      xboxStatus.textContent = data.gamertag ? "Connected as " + data.gamertag : "Connected";
      xboxForm.classList.add("hidden");
      xboxActions.classList.remove("hidden");
      if (xboxAutoSync) xboxAutoSync.value = data.auto_sync_interval != null ? String(data.auto_sync_interval) : "";

      if (data.last_sync_error) {
        xboxSyncStatus.textContent = "Last sync failed: " + data.last_sync_error;
        xboxSyncStatus.className = "text-[11px] text-red-400 mt-3";
      } else if (data.last_sync_at) {
        xboxSyncStatus.textContent = "Last synced: " + new Date(data.last_sync_at).toLocaleString("de-DE") + " · " + (data.last_sync_count ?? 0) + " games";
        xboxSyncStatus.className = "text-[11px] text-zinc-600 mt-3";
      } else {
        xboxSyncStatus.textContent = "Not synced yet.";
      }
    } catch (error) {
      xboxBadge.textContent = "Error";
      xboxBadge.className = "px-2.5 py-1 rounded-full bg-red-500/10 text-red-400 text-[10px] font-black uppercase tracking-wider";
      xboxStatus.textContent = error?.message || "Could not check connection";
    }
  };

  psnAutoSync?.addEventListener("change", () => setAutoSync("psn", psnAutoSync.value, psnAutoSync));
  xboxAutoSync?.addEventListener("change", () => setAutoSync("xbox", xboxAutoSync.value, xboxAutoSync));

  document.getElementById("xbox-connect-btn")?.addEventListener("click", async () => {
    const button = document.getElementById("xbox-connect-btn");
    button.disabled = true;
    setXboxMessage("Opening Microsoft sign-in…");

    try {
      const res = await api("/xbox/authorize");
      if (!res.ok) throw new Error(await readError(res, "Could not start Xbox authentication."));
      const data = await res.json();
      window.open(data.authorization_url, "_blank", "noopener,noreferrer");
      xboxCompleteForm.classList.remove("hidden");
      setXboxMessage("Sign in in the new tab, then paste the redirect URL here.");
    } catch (error) {
      setXboxMessage(error?.message || "Xbox authentication failed.", true);
    } finally {
      button.disabled = false;
    }
  });

  document.getElementById("xbox-complete-btn")?.addEventListener("click", async () => {
    const button = document.getElementById("xbox-complete-btn");
    const value = xboxCode.value.trim();
    if (!value) {
      setXboxMessage("Paste the Microsoft redirect URL or authorization code first.", true);
      return;
    }

    button.disabled = true;
    setXboxMessage("Completing Xbox authentication…");

    try {
      const res = await api("/xbox/complete", {
        method: "POST",
        body: JSON.stringify({ code_or_url: value }),
      });
      if (!res.ok) throw new Error(await readError(res, "Xbox authentication failed."));
      xboxCode.value = "";
      xboxCompleteForm.classList.add("hidden");
      setXboxMessage("Xbox connected. You can now sync your games.");
      await refreshXboxStatus();
    } catch (error) {
      setXboxMessage(error?.message || "Xbox authentication failed.", true);
    } finally {
      button.disabled = false;
    }
  });

  document.getElementById("xbox-sync-btn")?.addEventListener("click", async () => {
    const button = document.getElementById("xbox-sync-btn");
    button.disabled = true;
    setXboxMessage("Syncing your Xbox library…");

    try {
      const res = await api("/xbox/sync", { method: "POST" });
      if (!res.ok) throw new Error(await readError(res, "Xbox sync failed."));
      const data = await res.json();
      setXboxMessage("Synced " + data.games_imported + " games.");
      await refreshXboxStatus();
      setTimeout(() => location.reload(), 500);
    } catch (error) {
      setXboxMessage(error?.message || "Xbox sync failed.", true);
      await refreshXboxStatus();
    } finally {
      button.disabled = false;
    }
  });

  document.getElementById("xbox-disconnect-btn")?.addEventListener("click", async () => {
    const res = await api("/xbox/disconnect", { method: "DELETE" });
    if (!res.ok) {
      setXboxMessage(await readError(res, "Could not disconnect Xbox."), true);
      return;
    }
    location.reload();
  });



  const setMessage = (value, error = false) => {
    message.textContent = value;
    message.className = "mt-3 text-xs " + (error ? "text-red-400" : "text-emerald-400");
    message.classList.remove("hidden");
  };

  const readError = async (res, fallback) => {
    try {
      const data = await res.json();
      return data.detail || fallback;
    } catch {
      return fallback;
    }
  };

  async function refreshStatus() {
    try {
      const res = await api("/psn/status");
      if (!res.ok) throw new Error(await readError(res, "Could not read PlayStation connection status."));
      const data = await res.json();

      if (!data.connected) {
        badge.textContent = "Offline";
        badge.className = "px-2.5 py-1 rounded-full bg-zinc-800 text-zinc-500 text-[10px] font-black uppercase tracking-wider";
        status.textContent = "Not connected";
        form.classList.remove("hidden");
        actions.classList.add("hidden");
        return;
      }

      badge.textContent = "Connected";
      badge.className = "px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-[10px] font-black uppercase tracking-wider";
      status.textContent = data.online_id ? "Connected as " + data.online_id : "Connected";
      form.classList.add("hidden");
      actions.classList.remove("hidden");
      if (psnAutoSync) psnAutoSync.value = data.auto_sync_interval != null ? String(data.auto_sync_interval) : "";

      if (data.last_sync_error) {
        syncStatus.textContent = "Last sync failed: " + data.last_sync_error;
        syncStatus.className = "text-[11px] text-red-400 mt-3";
      } else if (data.last_sync_at) {
        syncStatus.textContent = "Last synced: " + new Date(data.last_sync_at).toLocaleString("de-DE") + " · " + (data.last_sync_count ?? 0) + " games";
        syncStatus.className = "text-[11px] text-zinc-600 mt-3";
      } else {
        syncStatus.textContent = "Not synced yet.";
      }
    } catch (error) {
      badge.textContent = "Error";
      badge.className = "px-2.5 py-1 rounded-full bg-red-500/10 text-red-400 text-[10px] font-black uppercase tracking-wider";
      status.textContent = error?.message || "Could not check connection";
    }
  }

  let psnBrowserState = "";

  const buildPsnBookmarklet = (state) => {
    const target = window.location.origin + "/api/proxy/psn/browser/complete";
    const code = [
      "(async()=>{",
      "const m=document.cookie.match(/(?:^|;\\s*)npsso=([^;]+)/);",
      'if(!m){alert("No PSN session cookie found. Please sign in to PlayStation first.");return;}',
      "try{",
      "await fetch(" + JSON.stringify(target) + ",{method:\"POST\",mode:\"no-cors\",headers:{\"Content-Type\":\"text/plain\"},body:" + JSON.stringify(state) + "+\"|\"+location.hostname+\"|\"+decodeURIComponent(m[1])});",
      'alert("Scrob: PlayStation login sent. Return to Scrob.");',
      '}catch(e){alert("Scrob: Could not send the PlayStation login.");}',
      "})()",
    ].join("");
    return "javascript:" + encodeURIComponent(code);
  };

  const startPsnBrowserLogin = async () => {
    const button = document.getElementById("psn-connect-btn");
    const panel = document.getElementById("psn-browser-panel");
    const statusEl = document.getElementById("psn-browser-status");
    const bookmarklet = document.getElementById("psn-bookmarklet");
    const openBtn = document.getElementById("psn-open-btn");
    const copyBtn = document.getElementById("psn-copy-bookmarklet");
    if (!button || !panel || !statusEl || !bookmarklet || !openBtn || !copyBtn) return;

    button.disabled = true;
    setMessage("Preparing PlayStation sign-in…");
    try {
      const res = await api("/psn/browser/start", { method: "POST" });
      if (!res.ok) throw new Error(await readError(res, "Could not start PlayStation authentication."));
      const data = await res.json();
      psnBrowserState = data.state;
      const href = buildPsnBookmarklet(psnBrowserState);
      bookmarklet.href = href;
      copyBtn.onclick = async () => {
        await navigator.clipboard.writeText(href);
        copyBtn.textContent = "Copied";
        setTimeout(() => { copyBtn.textContent = "Copy bookmarklet"; }, 1500);
      };
      openBtn.href = data.playstation_url;
      panel.classList.remove("hidden");
      statusEl.textContent = "Waiting for the PlayStation session…";
      window.open(data.playstation_url, "_blank", "noopener,noreferrer");
      const deadline = Date.now() + (data.expires_in * 1000);
      while (Date.now() < deadline && psnBrowserState) {
        await new Promise(resolve => setTimeout(resolve, 1000));
        const poll = await api("/psn/browser/status?state=" + encodeURIComponent(psnBrowserState));
        if (!poll.ok) throw new Error(await readError(poll, "PlayStation login failed."));
        const result = await poll.json();
        if (result.status === "completed") {
          psnBrowserState = "";
          statusEl.textContent = "Connected as " + result.online_id + ".";
          setMessage("PlayStation connected. You can now sync your games.");
          await refreshStatus();
          return;
        }
      }
      throw new Error("PlayStation login timed out. Start the connection again.");
    } catch (error) {
      setMessage(error?.message || "PlayStation authentication failed.", true);
    } finally {
      button.disabled = false;
    }
  };

  document.getElementById("psn-connect-btn")?.addEventListener("click", startPsnBrowserLogin);
  document.getElementById("psn-sync-btn")?.addEventListener("click", async () => {
    const button = document.getElementById("psn-sync-btn");
    button.disabled = true;
    setMessage("Syncing your PlayStation library…");

    try {
      const res = await api("/psn/sync", { method: "POST" });
      if (!res.ok) throw new Error(await readError(res, "PlayStation sync failed."));
      const data = await res.json();
      setMessage("Synced " + data.games_imported + " games.");
      await refreshStatus();
      setTimeout(() => location.reload(), 500);
    } catch (error) {
      setMessage(error?.message || "PlayStation sync failed.", true);
      await refreshStatus();
    } finally {
      button.disabled = false;
    }
  });

  document.getElementById("psn-disconnect-btn")?.addEventListener("click", async () => {
    const res = await api("/psn/disconnect", { method: "DELETE" });
    if (!res.ok) {
      setMessage(await readError(res, "Could not disconnect PlayStation."), true);
      return;
    }
    location.reload();
  });

  refreshStatus();
  refreshXboxStatus();
</script>
