  xbox: "M4.102 21.033A11.95 11.95 0 0 0 12 24a11.96 11.96 0 0 0 7.902-2.967c1.877-1.912-4.316-8.709-7.902-11.417-3.582 2.708-9.779 9.505-7.898 11.417m11.16-14.406c2.5 2.961 7.484 10.313 6.076 12.912A11.94 11.94 0 0 0 24 12.004a11.95 11.95 0 0 0-3.57-8.536s-.027-.022-.082-.042a.8.8 0 0 0-.281-.045c-.592 0-1.985.434-4.805 3.246M3.654 3.426c-.057.02-.082.042-.086.042A11.96 11.96 0 0 0 0 12.004c0 2.854.998 5.473 2.661 7.533-1.401-2.605 3.579-9.951 6.08-12.91-2.82-2.813-4.216-3.245-4.806-3.245a.7.7 0 0 0-.281.046zM12 3.551S9.055 1.828 6.755 1.746c-.903-.033-1.454.295-1.521.339C7.379.646 9.659 0 11.984 0H12c2.334 0 4.605.646 6.766 2.085-.068-.046-.615-.372-1.52-.339C14.946 1.828 12 3.545 12 3.545z",
  nintendo: "M0 .6h7.1l9.85 15.9V.6H24v22.8h-7.04L7.06 7.5v15.9H0V.6Z",
};
---
{key === "pc" ? (
  <span class="inline-flex items-center justify-center leading-none" title="PC" aria-label="PC" style={"font-size:" + size + "px"}>🖥️</span>
) : key === "unknown" ? (
  <span class="inline-flex items-center justify-center leading-none" title={platform || "Plattform"} aria-label={platform || "Plattform"} style={"font-size:" + size + "px"}>🎮</span>
) : (
  <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true" class="inline-block shrink-0">
    <path d={paths[key]} />
  </svg>
)}
