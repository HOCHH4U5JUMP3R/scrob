---
interface Props {
  platform?: string | null;
  size?: number;
}
const { platform = "", size = 16 } = Astro.props;
const name = String(platform ?? "").toLowerCase();
const key = name.includes("playstation") || name.startsWith("ps") ? "playstation"
  : name.includes("xbox") ? "xbox"
  : name.includes("steam") || name === "pc" || name.includes("windows") ? "pc"
  : name.includes("nintendo") || name.includes("switch") || name.includes("wii") || name.includes("3ds") || name.includes("2ds") || name.includes("gamecube") ? "nintendo"
  : "unknown";
const paths: Record<string, string> = {
