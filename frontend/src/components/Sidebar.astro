---
interface Props {
  user?: { id: number; display_name: string; is_admin?: boolean } | null;
  showAnonNavLinks?: boolean;
  pathname: string;
  pendingRequestCount?: number;
}
const { user, showAnonNavLinks = false, pathname, pendingRequestCount = 0 } = Astro.props;

const active = (match: boolean) =>
  match
    ? "bg-zinc-800 text-zinc-100"
    : "text-zinc-400 hover:text-zinc-100 hover:bg-zinc-900";

const icon = "w-5 h-5 shrink-0";
const activeHome = pathname === "/";
const activeMovies = pathname.startsWith("/movies") || pathname.startsWith("/collection/movies") || pathname.startsWith("/trending/movies") || pathname.startsWith("/media/movie");
const activeShows = pathname.startsWith("/shows") || pathname.startsWith("/collection/shows") || pathname.startsWith("/show") || pathname.startsWith("/trending/shows");
const activeHistory = pathname.startsWith("/history") || pathname === "/next-up";
const activeLists = pathname.startsWith("/lists") || pathname.startsWith("/list/");
const activeStats = pathname.startsWith("/stats");
const activeDiscover = pathname.startsWith("/discover");
const activeCalendar = pathname.startsWith("/calendar");
const activeConnections = pathname.startsWith("/connections");
const activeSettings = pathname === "/settings" || pathname === "/user-settings";
const activeAdmin = pathname.startsWith("/admin") || pathname.startsWith("/requests");
---
{(user || showAnonNavLinks) && (
  <>
    <aside id="scrob-sidebar" class="hidden md:flex fixed inset-y-0 left-0 z-40 w-64 flex-col border-r border-zinc-800/80 bg-zinc-950/95 backdrop-blur-xl">
      <div class="flex h-20 items-center px-6 border-b border-zinc-800/70">
        <a href="/" class="flex items-center gap-3 text-zinc-100 font-bold text-lg tracking-tight group">
          <img src="/favicon.svg" alt="" class="w-8 h-8 group-hover:scale-105 transition-transform" />
          <span>Scrob</span>
        </a>
      </div>

      <div class="flex-1 overflow-y-auto px-3 py-5">
        <p class="px-3 mb-2 text-[10px] font-bold uppercase tracking-[0.16em] text-zinc-600">Library</p>
        <nav class="space-y-1">
          <a href="/" class={`flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors ${active(activeHome)}`}>
            <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Home
          </a>
          <a href="/collection/movies" class={`flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors ${active(activeMovies)}`}>
            <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M17 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
            Movies
          </a>
          <a href="/collection/shows" class={`flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors ${active(activeShows)}`}>
            <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="15" x="2" y="7" rx="2"/><polyline points="17 2 12 7 7 2"/></svg>
            Shows
          </a>
          {user && (
            <a href="/lists" class={`flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors ${active(activeLists)}`}>
              <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              Lists
            </a>
          )}
        </nav>

        {user && (
          <>
            <p class="px-3 mt-7 mb-2 text-[10px] font-bold uppercase tracking-[0.16em] text-zinc-600">Activity</p>
            <nav class="space-y-1">
              <a href="/history" class={`flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors ${active(activeHistory)}`}>
                <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                History
              </a>
              <a href={`/stats/${user.id}`} class={`flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors ${active(activeStats)}`}>
                <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>
                Statistics
              </a>
              <a href="/discover" class={`flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors ${active(activeDiscover)}`}>
                <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
                Discover
              </a>
              <a href="/games" class={`flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors ${active(pathname.startsWith("/games") || pathname.startsWith("/game/"))}`}>
            <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 11h12"/><path d="M8 8v6"/><path d="M5 16l-1.5 2.2a2 2 0 0 0 3.2 2.3L9 18h6l2.3 2.5a2 2 0 0 0 3.2-2.3L19 16a7 7 0 1 0-14 0Z"/><circle cx="16.5" cy="11" r=".7" fill="currentColor"/><circle cx="19" cy="9.5" r=".7" fill="currentColor"/></svg>
            Games
          </a>
          <a href="/calendar" class={`flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors ${active(activeCalendar)}`}>
                <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                Calendar
              </a>
            </nav>
          </>
        )}

        {user && (
          <>
            <p class="px-3 mt-7 mb-2 text-[10px] font-bold uppercase tracking-[0.16em] text-zinc-600">Account</p>
            <nav class="space-y-1">
              <a href="/connections" class={`flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors ${active(activeConnections)}`}>
                <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                Connections
              </a>
              <a href="/user-settings" class={`flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors ${active(activeSettings)}`}>
                <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 1 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09A1.65 1.65 0 0 0 16 4.6a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c0 .83.67 1.5 1.5 1.5H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                Settings
              </a>
              {user.is_admin && (
                <a href="/admin" class={`flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors ${active(activeAdmin)}`}>
                  <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.79 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
                  Admin
                </a>
              )}
              {user.is_admin && (
                <a href="/requests" class={`flex items-center justify-between rounded-xl px-3 py-2.5 text-sm font-medium transition-colors ${active(activeAdmin)}`}>
                  <span class="flex items-center gap-3">
                    <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24A2 2 0 0 0 5.45 5.11z"/></svg>
                    Requests
                  </span>
                  {pendingRequestCount > 0 && <span class="min-w-5 h-5 px-1.5 flex items-center justify-center text-[10px] font-bold bg-blue-500 text-white rounded-full">{pendingRequestCount}</span>}
                </a>
              )}
            </nav>
          </>
        )}
      </div>

      {user && (
        <div class="border-t border-zinc-800/70 p-3">
          <div class="flex items-center gap-3 rounded-xl bg-zinc-900/70 px-3 py-2.5">
            <div class="w-9 h-9 rounded-full bg-zinc-800 flex items-center justify-center text-sm font-bold text-zinc-300">{user.display_name.slice(0, 1).toUpperCase()}</div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-zinc-200 truncate">{user.display_name}</div>
              <div class="text-xs text-zinc-500">Scrob account</div>
            </div>
          </div>
        </div>
      )}
    </aside>
  </>
)}
