---
import Base from "../../layouts/Base.astro";
export const prerender = false;
const { id } = Astro.params;
const { token } = Astro.locals;
let game: any = null;
let error = "";
try {
  const res = await fetch(`http://localhost:${import.meta.env.BACKEND_PORT ?? "7331"}/games/${id}`, { headers: token ? { Authorization: `Bearer ${token}` } : {} });
  if (res.ok) game = await res.json();
  else error = res.status === 404 ? "Game not found." : "Failed to load game.";
} catch { error = "Failed to load game."; }
---
<Base title={game?.title ?? "Game"}>
  {error ? (
    <div class="max-w-md mx-auto mt-20 text-center"><div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-10"><h1 class="text-xl font-black">{error}</h1><a href="/games" class="inline-block mt-6 px-5 py-2.5 rounded-xl bg-sky-600 text-white font-bold">Back to Games</a></div></div>
  ) : game ? (
    <div class="relative min-h-[calc(100vh-5rem)]">
      {game.backdrop_path && <div class="absolute inset-x-0 top-0 h-[45vh] overflow-hidden opacity-35"><img src={game.backdrop_path} alt="" class="w-full h-full object-cover"/><div class="absolute inset-0 bg-gradient-to-b from-zinc-950/30 via-zinc-950/80 to-zinc-950"/></div>}
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-14">
        <a href="/games" class="text-xs font-black uppercase tracking-widest text-zinc-500 hover:text-zinc-200">← Games</a>
        <div class="grid md:grid-cols-[220px_1fr] gap-8 md:gap-10 pt-8">
          <div>{game.cover_path ? <img src={game.cover_path} alt={game.title} class="w-full rounded-2xl shadow-2xl border border-zinc-800"/> : <div class="aspect-[2/3] rounded-2xl bg-zinc-900 border border-zinc-800"/>}</div>
          <div class="self-center"><p class="text-[10px] font-black uppercase tracking-[.2em] text-sky-400">Game</p><h1 class="text-4xl md:text-6xl font-black tracking-tight text-white mt-2">{game.title}</h1>
            {game.original_title && game.original_title !== game.title && <p class="text-zinc-500 mt-2">{game.original_title}</p>}
            <div class="flex flex-wrap gap-2 mt-5">
              {game.release_date && <span class="px-3 py-1.5 rounded-full bg-zinc-900/80 border border-zinc-800 text-xs font-bold text-zinc-300">{game.release_date.slice(0,4)}</span>}
              {game.genres?.map((g:string) => <span class="px-3 py-1.5 rounded-full bg-zinc-900/80 border border-zinc-800 text-xs font-bold text-zinc-400">{g}</span>)}
              {game.platforms?.map((p:any) => <span class="px-3 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-xs font-black text-sky-300">{p.platform_name || p.platform}</span>)}
            </div>
            {game.overview && <p class="max-w-3xl text-zinc-300 leading-7 mt-7">{game.overview}</p>}
          </div>
        </div>
      </div>
    </div>
  ) : null}
</Base>
