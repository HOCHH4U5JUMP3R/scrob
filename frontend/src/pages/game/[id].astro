---
import Base from "../../layouts/Base.astro";
import GamePlatformIcon from "../../components/GamePlatformIcon.astro";
export const prerender = false;

const { id } = Astro.params;
const { token } = Astro.locals;
let game: any = null;
let error = "";

try {
  const res = await fetch(
    `http://localhost:${import.meta.env.BACKEND_PORT ?? "7331"}/games/${id}`,
    { headers: token ? { Authorization: `Bearer ${token}` } : {} }
  );
  if (res.ok) game = await res.json();
  else error = res.status === 404 ? "Spiel nicht gefunden." : "Spiel konnte nicht geladen werden.";
} catch {
  error = "Spiel konnte nicht geladen werden.";
}

const stats = game?.stats ?? [];
const isXboxPlatform = (platform: any) => String(platform ?? "").toLowerCase().includes("xbox");
const isPCPlatform = (platform: any) => {
  const value = String(platform ?? "").toLowerCase();
  return value === "pc" || value === "windows" || value.includes("steam");
};
const playtime = stats.reduce((sum: number, s: any) => sum + (Number(s.playtime_minutes) || 0), 0);
const xboxPlayCount = (game?.play_history ?? []).filter((activity: any) => isXboxPlatform(activity.platform)).length;
// Xbox does not provide a reliable play count; count its recorded activity rows once.
// Keep provider-supplied counts for PlayStation and other platforms.
const playCount = stats.reduce((sum: number, s: any) => sum + (isXboxPlatform(s.platform) ? 0 : (Number(s.play_count) || 0)), 0)
  + (stats.some((s: any) => isXboxPlatform(s.platform)) ? xboxPlayCount : 0);

const trophyValue = (t: any, key: string) => Number(t?.[key] ?? t?.[key.toLowerCase()] ?? 0);
const xboxStats = stats.filter((s: any) => isXboxPlatform(s.platform));
const pcStats = stats.filter((s: any) => isPCPlatform(s.platform));
const hasNonXboxStats = stats.some((s: any) => !isXboxPlatform(s.platform));
const pcAchievementsEarned = pcStats.reduce((sum: number, s: any) => sum + trophyValue(s.trophies_earned, "achievements"), 0);
const pcAchievementsDefined = pcStats.reduce((sum: number, s: any) => sum + trophyValue(s.trophies_defined, "achievements"), 0);
const xboxGamerscoreEarned = xboxStats.reduce((sum: number, s: any) => sum + trophyValue(s.trophies_earned, "gamerscore"), 0);
const xboxGamerscoreDefined = xboxStats.reduce((sum: number, s: any) => sum + trophyValue(s.trophies_defined, "gamerscore"), 0);
const xboxProgress = xboxGamerscoreDefined > 0 ? Math.floor(xboxGamerscoreEarned / xboxGamerscoreDefined * 100) : 0;
const trophyEarned = stats.filter((s: any) => !isXboxPlatform(s.platform)).reduce((sum: number, s: any) => {
  const t = s.trophies_earned || {};
  return sum + ["bronze", "silver", "gold", "platinum"].reduce((n: number, key: string) => n + trophyValue(t, key), 0);
}, 0);
const trophyDefined = stats.filter((s: any) => !isXboxPlatform(s.platform)).reduce((sum: number, s: any) => {
  const t = s.trophies_defined || {};
  return sum + ["bronze", "silver", "gold", "platinum"].reduce((n: number, key: string) => n + trophyValue(t, key), 0);
}, 0);
const trophySummaryLabel = xboxStats.length && !hasNonXboxStats ? "Erfolge" : (pcStats.length && !stats.some((s: any) => !isPCPlatform(s.platform)) ? "Erfolge" : (xboxStats.length && hasNonXboxStats ? "Fortschritt" : "Trophäen"));
const trophySummaryValue = xboxStats.length && !hasNonXboxStats
  ? `${xboxProgress}%`
  : (pcStats.length && !stats.some((s: any) => !isPCPlatform(s.platform))
    ? `${pcAchievementsEarned}/${pcAchievementsDefined}`
    : (xboxStats.length && hasNonXboxStats
      ? `${trophyEarned}/${trophyDefined} · Xbox ${xboxProgress}%`
      : `${trophyEarned}${trophyDefined ? ` / ${trophyDefined}` : ""}`));
const formatMinutes = (minutes: number) => {
  if (!minutes) return "0 Min.";
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  return hours ? (mins ? `${hours} Std. ${mins} Min.` : `${hours} Std.`) : `${mins} Min.`;
};
const parseTimestamp = (value: string) => {
  const raw = String(value).trim();
  // API timestamps without a zone are UTC; display them in the browser's local timezone.
  return new Date(/(?:Z|[+-]\d{2}:?\d{2})$/i.test(raw) ? raw : raw + "Z");
};
const formatDate = (value: string | null) => {
  if (!value) return "—";
  return new Intl.DateTimeFormat("de-DE", { dateStyle: "medium" }).format(parseTimestamp(value));
};
const latestPlayed = stats
  .map((s: any) => s.last_played_at)
  .filter(Boolean)
  .sort()
  .at(-1);
---

<Base title={game?.title ?? "Spiel"}>
  {error ? (
    <div class="max-w-md mx-auto mt-20 text-center">
      <div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-10">
        <h1 class="text-xl font-black">{error}</h1>
        <a href="/games" class="inline-block mt-6 px-5 py-2.5 rounded-xl bg-sky-600 text-white font-bold">Zurück zu den Spielen</a>
      </div>
    </div>
  ) : game ? (
    <div class="relative min-h-[calc(100vh-5rem)]">
      {game.backdrop_path && (
        <div class="absolute inset-x-0 top-0 h-[48vh] overflow-hidden opacity-40">
          <img src={game.backdrop_path} alt="" class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-b from-zinc-950/20 via-zinc-950/75 to-zinc-950" />
        </div>
      )}

      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-12">
        <a href="/games" class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest text-zinc-500 hover:text-zinc-200">← Spiele</a>

        <div class="grid md:grid-cols-[240px_1fr] gap-8 md:gap-10 pt-7">
          <div>
            {game.cover_path ? (
              <img src={game.cover_path} alt={game.title} class="w-full rounded-2xl shadow-2xl border border-zinc-800" />
            ) : (
              <div class="aspect-[2/3] rounded-2xl bg-zinc-900 border border-zinc-800" />
            )}
          </div>

          <div class="self-center">
            <p class="text-[10px] font-black uppercase tracking-[.2em] text-sky-400">Spiel</p>
            <h1 class="text-4xl md:text-6xl font-black tracking-tight text-white mt-2">{game.title}</h1>
            {game.original_title && game.original_title !== game.title && <p class="text-zinc-500 mt-2">{game.original_title}</p>}

            <div class="flex flex-wrap gap-2 mt-5">
              {game.release_date && <span class="px-3 py-1.5 rounded-full bg-zinc-900/80 border border-zinc-800 text-xs font-bold text-zinc-300">{game.release_date.slice(0, 4)}</span>}
              {game.genres?.map((g: string) => <span class="px-3 py-1.5 rounded-full bg-zinc-900/80 border border-zinc-800 text-xs font-bold text-zinc-400">{g}</span>)}
              {game.platforms?.map((p: any) => <span class="px-3 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-xs font-black text-sky-300">{p.platform_name || p.platform}</span>)}
            </div>

            {game.overview && <p class="max-w-3xl text-zinc-300 leading-7 mt-7">{game.overview}</p>}
          </div>
        </div>

        {pcStats.length > 0 && (
          <section class="mt-8 rounded-2xl border border-zinc-800 bg-zinc-900/60 p-5">
            <h2 class="text-lg font-black text-white">PC-Spiel bearbeiten</h2>
            <p class="text-xs text-zinc-500 mt-1">Cover und Erfolge manuell pflegen</p>
            <form id="manual-pc-game-form" data-game-id={id} class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-4">
              <label class="text-xs font-bold text-zinc-400">Neues Cover (JPG, PNG, WebP · max. 5 MB)
                <input id="manual-pc-cover" type="file" accept="image/jpeg,image/png,image/webp" class="mt-1 block w-full text-xs text-zinc-300 file:mr-3 file:rounded-lg file:border-0 file:bg-zinc-800 file:px-3 file:py-2 file:text-zinc-200" />
              </label>
              <label class="text-xs font-bold text-zinc-400">Erfolge freigeschaltet
                <input id="manual-pc-achievements-earned" type="number" min="0" max="1000000" step="1" value={pcAchievementsEarned} required class="mt-1 w-full rounded-lg border border-zinc-700 bg-zinc-950 p-3 text-sm text-white" />
              </label>
              <label class="text-xs font-bold text-zinc-400">Erfolge gesamt
                <input id="manual-pc-achievements-defined" type="number" min="0" max="1000000" step="1" value={pcAchievementsDefined} required class="mt-1 w-full rounded-lg border border-zinc-700 bg-zinc-950 p-3 text-sm text-white" />
              </label>
              <div class="sm:col-span-2 lg:col-span-3 flex items-center justify-between gap-3 flex-wrap">
                <p id="manual-pc-game-message" class="text-xs text-zinc-400" role="status" aria-live="polite"></p>
                <button id="manual-pc-game-submit" type="submit" class="rounded-lg bg-sky-600 hover:bg-sky-500 px-5 py-3 text-sm font-bold text-white">Änderungen speichern</button>
              </div>
            </form>
          </section>
        )}
        </div>

        {stats.length > 0 && (
          <section class="mt-12">
            <div class="flex items-end justify-between gap-4 mb-4">
              <div>
                <p class="text-[10px] font-black uppercase tracking-[.2em] text-sky-400">Deine Aktivität</p>
                <h2 class="text-2xl font-black text-white mt-1">Spielstatistik</h2>
              </div>
              <span class="text-xs text-zinc-500">{stats.length} {stats.length === 1 ? "Plattform" : "Plattformen"}</span>
            </div>

            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
              <div class="rounded-2xl border border-zinc-800 bg-zinc-900/75 p-5">
                <p class="text-xs font-bold text-zinc-500">Spielzeit</p>
                <p class="text-2xl font-black text-white mt-2">{formatMinutes(playtime)}</p>
              </div>
              <div class="rounded-2xl border border-zinc-800 bg-zinc-900/75 p-5">
                <p class="text-xs font-bold text-zinc-500">Spielstarts</p>
                <p class="text-2xl font-black text-white mt-2">{playCount}</p>
              </div>
              <div class="rounded-2xl border border-zinc-800 bg-zinc-900/75 p-5">
                <p class="text-xs font-bold text-zinc-500">Zuletzt gespielt</p>
                <p class="text-lg font-black text-white mt-2">{formatDate(latestPlayed)}</p>
              </div>
              <div class="rounded-2xl border border-zinc-800 bg-zinc-900/75 p-5">
                <p class="text-xs font-bold text-zinc-500">{xboxStats.length && !hasNonXboxStats ? <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Erfolge" title="Erfolge"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4Z"/><path d="M7 6H4v2a4 4 0 0 0 4 4M17 6h3v2a4 4 0 0 1-4 4"/></svg> : trophySummaryLabel}</p>
                <p class={`font-black text-white mt-2 ${trophySummaryValue.length > 14 ? "text-sm" : "text-2xl"}`}>{trophySummaryValue}</p>
              </div>
            </div>

            <div class="grid lg:grid-cols-2 gap-4 mt-4">
              {stats.map((s: any) => {
                const earned = s.trophies_earned || {};
                const defined = s.trophies_defined || {};
                const isXbox = isXboxPlatform(s.platform);
                const isPC = isPCPlatform(s.platform);
                const gamerscoreEarned = trophyValue(earned, "gamerscore");
                const gamerscoreDefined = trophyValue(defined, "gamerscore");
                const achievementsEarned = trophyValue(earned, "achievements");
                const achievementsDefined = trophyValue(defined, "achievements");
                const progress = isXbox
                  ? (gamerscoreDefined > 0 ? Math.floor(gamerscoreEarned / gamerscoreDefined * 100) : Number(s.trophy_progress || 0))
                  : Math.max(0, Math.min(100, Number(s.trophy_progress || 0)));
                const pcAchievementsEarnedForStat = trophyValue(earned, "achievements");
                const pcAchievementsDefinedForStat = trophyValue(defined, "achievements");
                const bronze = trophyValue(earned, "bronze");
                const silver = trophyValue(earned, "silver");
                const gold = trophyValue(earned, "gold");
                const platinum = trophyValue(earned, "platinum");
                return (
                  <div class="rounded-2xl border border-zinc-800 bg-zinc-900/75 p-5">
                    <div class="flex items-center justify-between gap-4">
                      <div>
                        <p class="text-xs font-black uppercase tracking-wider text-sky-400">{s.platform}</p>
                        <p class="text-sm text-zinc-400 mt-1">{formatMinutes(s.playtime_minutes || 0)} · {isXboxPlatform(s.platform) ? xboxPlayCount : (s.play_count || 0)} Spielstarts</p>
                      </div>
                      <p class="text-2xl font-black text-white">{progress}%</p>
                    </div>

                    <div class="h-2 bg-zinc-800 rounded-full overflow-hidden mt-5">
                      <div class="h-full bg-sky-500 rounded-full" style={`width: ${progress}%`} />
                    </div>

                    {isPC ? (
                      <div class="mt-5 rounded-xl bg-zinc-950/70 p-4">
                        <p class="text-xs font-black uppercase tracking-wider text-emerald-400">Erfolge</p>
                        <p class="text-2xl font-black text-white mt-1">{pcAchievementsEarnedForStat}<span class="text-sm text-zinc-500">/{pcAchievementsDefinedForStat}</span></p>
                      </div>
                    ) : isXbox ? (
                      <div class="grid grid-cols-2 gap-2 mt-5">
                        <div class="rounded-xl bg-zinc-950/70 p-3 text-center">
                          <p title="Erfolge" aria-label="Erfolge" class="text-xs font-black text-emerald-400 flex justify-center"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4Z"/><path d="M7 6H4v2a4 4 0 0 0 4 4M17 6h3v2a4 4 0 0 1-4 4"/></svg></p>
                          <p class="text-lg font-black text-white mt-1">{achievementsEarned}{achievementsDefined ? <span class="text-xs text-zinc-600">/{achievementsDefined}</span> : null}</p>
                        </div>
                        <div class="rounded-xl bg-zinc-950/70 p-3 text-center">
                          <p title="Gamerscore" aria-label="Gamerscore" class="text-xs font-black text-emerald-400 flex justify-center"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.8"/><text x="12" y="16" text-anchor="middle" font-size="12" font-weight="900" fill="currentColor">G</text></svg></p>
                          <p class="text-lg font-black text-white mt-1">{gamerscoreEarned}<span class="text-xs text-zinc-600">/{gamerscoreDefined}</span></p>
                        </div>
                      </div>
                    ) : (
                      <div class="grid grid-cols-4 gap-2 mt-5">
                        <div class="rounded-xl bg-zinc-950/70 p-3 text-center">
                          <p class="text-xs font-black text-amber-700">Bronze</p>
                          <p class="text-lg font-black text-white mt-1">{bronze}<span class="text-xs text-zinc-600">/{trophyValue(defined, "bronze")}</span></p>
                        </div>
                        <div class="rounded-xl bg-zinc-950/70 p-3 text-center">
                          <p class="text-xs font-black text-zinc-300">Silber</p>
                          <p class="text-lg font-black text-white mt-1">{silver}<span class="text-xs text-zinc-600">/{trophyValue(defined, "silver")}</span></p>
                        </div>
                        <div class="rounded-xl bg-zinc-950/70 p-3 text-center">
                          <p class="text-xs font-black text-yellow-400">Gold</p>
                          <p class="text-lg font-black text-white mt-1">{gold}<span class="text-xs text-zinc-600">/{trophyValue(defined, "gold")}</span></p>
                        </div>
                        <div class="rounded-xl bg-zinc-950/70 p-3 text-center">
                          <p class="text-xs font-black text-sky-300">Platin</p>
                          <p class="text-lg font-black text-white mt-1">{platinum}<span class="text-xs text-zinc-600">/{trophyValue(defined, "platinum")}</span></p>
                        </div>
                      </div>
                    )}

                    <p class="text-xs text-zinc-600 mt-4">Zuletzt gespielt: {formatDate(s.last_played_at)}</p>
                  </div>
                );
              })}
            </div>
          </section>
        )}

        <section class="mt-10 rounded-2xl border border-zinc-800 bg-zinc-900/60 p-5">
          <div class="flex items-center justify-between gap-3">
            <h2 id="activity-form-title" class="text-base font-black text-white">Spielaktivität hinzufügen</h2>
            <button id="cancel-activity-edit" type="button" class="hidden text-xs font-semibold text-zinc-400 hover:text-white">Abbrechen</button>
          </div>
          <form id="game-activity-form" data-game-id={id} class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 mt-4">
            <label class="text-xs text-zinc-400">Plattform
              <select id="activity-platform" name="platform" required class="mt-1 w-full rounded-lg border border-zinc-700 bg-zinc-950 p-2 text-sm text-white">
                <option value="Xbox">Xbox</option><option value="PlayStation">PlayStation</option><option value="PC">PC</option><option value="Nintendo">Nintendo</option>
              </select>
            </label>
            <label class="text-xs text-zinc-400">Datum und Uhrzeit
              <input id="activity-played-at" name="played_at" type="datetime-local" required class="mt-1 w-full rounded-lg border border-zinc-700 bg-zinc-950 p-2 text-sm text-white" />
            </label>
            <label class="text-xs text-zinc-400">Spielzeit (Minuten)
              <input id="activity-duration" name="duration_minutes" type="number" min="0" max="1000000" step="1" value="0" required class="mt-1 w-full rounded-lg border border-zinc-700 bg-zinc-950 p-2 text-sm text-white" />
            </label>
            <div class="flex items-end"><button id="activity-submit" class="w-full rounded-lg bg-sky-600 hover:bg-sky-500 px-4 py-2 text-sm font-bold text-white" type="submit">Aktivität speichern</button></div>
          </form>
          <p id="game-activity-message" class="text-xs text-zinc-500 mt-3" role="status" aria-live="polite"></p>
        </section>
        {game.play_history?.length > 0 && (
          <section class="mt-10">
            <div class="flex items-end justify-between gap-4 mb-4">
              <div>
                <p class="text-[10px] font-black uppercase tracking-[.2em] text-violet-400">Verlauf</p>
                <h2 class="text-2xl font-black text-white mt-1">Letzte Spielaktivitäten</h2>
              </div>
              <span class="text-xs text-zinc-500">{game.play_history.length} gespeicherte {game.play_history.length === 1 ? "Aktivität" : "Aktivitäten"}</span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 xl:grid-cols-6 gap-4">
              {game.play_history.map((activity: any) => (
                <div class="group min-w-0">
                  <p class="text-xs font-semibold text-zinc-300 mb-2">{activity.played_at ? formatDate(activity.played_at) + " · " + new Intl.DateTimeFormat("de-DE", { timeStyle: "short" }).format(parseTimestamp(activity.played_at)) : "Datum und Uhrzeit unbekannt"}</p>
                  <div class="aspect-[2/3] rounded-xl overflow-hidden bg-zinc-800 border border-zinc-800 relative">
                    {game.cover_path ? <img src={game.cover_path} alt="" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform" /> : <div class="w-full h-full flex items-center justify-center text-zinc-600 text-xs">Spiel</div>}
                    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-zinc-950 via-zinc-950/85 to-transparent p-3 pt-8">
                      <div class="flex items-center justify-between gap-2"><span title={activity.platform} class="text-white"><GamePlatformIcon platform={activity.platform} size={17} /></span>{activity.observed_at && activity.source !== "manual" && <span title="Mit Plattform synchronisiert" aria-label="Synchronisiert" class="text-emerald-300 text-sm"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7v5h-5"/><path d="M4 17v-5h5"/><path d="M5.6 9a7 7 0 0 1 11.6-2L20 12M4 12l2.8 5a7 7 0 0 0 11.6-2"/></svg></span>}</div>
                      <p class="text-[11px] text-zinc-300 mt-1">{activity.duration_minutes > 0 ? formatMinutes(activity.duration_minutes) : "Spielaktivität"}</p>
                    </div>
                  </div>
<button type="button" class="edit-game-activity mt-1 text-[11px] font-semibold text-sky-400 hover:text-sky-300" data-id={activity.id} data-platform={activity.platform} data-source={activity.source} data-date={activity.played_at ?? ""} data-duration={activity.duration_minutes ?? 0}>Bearbeiten</button>
                </div>
              ))}
            </div>
          </section>
        )}

        {stats.length === 0 && (
          <div class="mt-10 rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6">
            <p class="text-sm text-zinc-400">Für dieses Spiel wurden noch keine PlayStation- oder Xbox-Aktivitäten synchronisiert.</p>
          </div>
        )}
      </div>
    </div>
  ) : null}
</Base>

<script>
  const manualPcForm = document.getElementById("manual-pc-game-form");
  const manualPcMessage = document.getElementById("manual-pc-game-message");
  const manualPcSubmit = document.getElementById("manual-pc-game-submit");
  const manualPcCover = document.getElementById("manual-pc-cover");
  const manualPcEarned = document.getElementById("manual-pc-achievements-earned");
  const manualPcDefined = document.getElementById("manual-pc-achievements-defined");
  const readManualPcCover = (file) => new Promise((resolve, reject) => {
    if (!file) return resolve(null);
    if (file.size > 5 * 1024 * 1024) return reject(new Error("Das Cover darf maximal 5 MB groß sein."));
    const reader = new FileReader();
    reader.onload = () => resolve(reader.result);
    reader.onerror = () => reject(new Error("Das Cover konnte nicht gelesen werden."));
    reader.readAsDataURL(file);
  });
  manualPcForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const earned = Number(manualPcEarned?.value ?? 0);
    const defined = Number(manualPcDefined?.value ?? 0);
    if (!Number.isInteger(earned) || !Number.isInteger(defined) || earned < 0 || defined < 0 || earned > defined) {
      if (manualPcMessage) manualPcMessage.textContent = "Bitte gültige Erfolge eingeben; freigeschaltet darf nicht größer als gesamt sein.";
      return;
    }
    if (manualPcSubmit) manualPcSubmit.disabled = true;
    if (manualPcMessage) manualPcMessage.textContent = "Speichere …";
    try {
      const coverData = await readManualPcCover(manualPcCover?.files?.[0] ?? null);
      const response = await fetch("/api/proxy/games/" + encodeURIComponent(manualPcForm.dataset.gameId || "") + "/manual", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cover_data: coverData, achievements_earned: earned, achievements_defined: defined }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.detail || "PC-Spiel konnte nicht aktualisiert werden.");
      if (manualPcMessage) manualPcMessage.textContent = "Gespeichert.";
      location.reload();
    } catch (error) {
      if (manualPcMessage) manualPcMessage.textContent = error instanceof Error ? error.message : "Speichern fehlgeschlagen.";
    } finally {
      if (manualPcSubmit) manualPcSubmit.disabled = false;
    }
  });

  const activityForm = document.getElementById("game-activity-form");
  const activityMessage = document.getElementById("game-activity-message");
  const activityPlatform = document.getElementById("activity-platform");
  const activityDate = document.getElementById("activity-played-at");
  const activityDuration = document.getElementById("activity-duration");
  const activityTitle = document.getElementById("activity-form-title");
  const activitySubmit = document.getElementById("activity-submit");
  const cancelEdit = document.getElementById("cancel-activity-edit");
  const gameId = activityForm?.dataset.gameId;
  const toLocalInput = (value) => {
    const date = value ? new Date(/(?:Z|[+-]\d{2}:?\d{2})$/i.test(value) ? value : value + "Z") : new Date();
    if (Number.isNaN(date.getTime())) return "";
    const pad = (number) => String(number).padStart(2, "0");
    return date.getFullYear() + "-" + pad(date.getMonth() + 1) + "-" + pad(date.getDate()) + "T" + pad(date.getHours()) + ":" + pad(date.getMinutes());
  };
  const resetActivityForm = () => {
    if (!activityForm) return;
    delete activityForm.dataset.activityId;
    activityPlatform.disabled = false;
    activityForm.reset();
    activityDate.value = toLocalInput("");
    activityTitle.textContent = "Spielaktivität hinzufügen";
    activitySubmit.textContent = "Aktivität speichern";
    cancelEdit?.classList.add("hidden");
    if (activityMessage) activityMessage.textContent = "";
  };
  if (activityDate) activityDate.value = toLocalInput("");
  cancelEdit?.addEventListener("click", resetActivityForm);
  document.querySelectorAll(".edit-game-activity").forEach((button) => {
    button.addEventListener("click", () => {
      if (!activityForm) return;
      const platform = button.getAttribute("data-platform") || "Xbox";
      activityPlatform.disabled = button.getAttribute("data-source") !== "manual";
      const optionExists = Array.from(activityPlatform.options).some((option) => option.value.toLowerCase() === platform.toLowerCase());
      if (!optionExists) activityPlatform.add(new Option(platform, platform));
      activityPlatform.value = platform;
      activityDate.value = toLocalInput(button.getAttribute("data-date") || "");
      activityDuration.value = button.getAttribute("data-duration") || "0";
      activityForm.dataset.activityId = button.getAttribute("data-id") || "";
      activityTitle.textContent = "Spielaktivität bearbeiten";
      activitySubmit.textContent = "Änderungen speichern";
      cancelEdit?.classList.remove("hidden");
      if (activityMessage) activityMessage.textContent = "";
      activityForm.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  });
  activityForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!gameId) return;
    const dateValue = activityDate.value;
    const payload = {
      platform: activityPlatform.value,
      played_at: dateValue ? new Date(dateValue).toISOString() : null,
      duration_minutes: Number(activityDuration.value || 0),
    };
    const activityId = activityForm.dataset.activityId;
    const url = activityId
      ? "/api/proxy/games/activity/" + encodeURIComponent(activityId)
      : "/api/proxy/games/" + encodeURIComponent(gameId) + "/activity";
    const method = activityId ? "PATCH" : "POST";
    if (activityMessage) activityMessage.textContent = "Speichere …";
    activitySubmit.disabled = true;
    try {
      const response = await fetch(url, { method, headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.detail || "Die Spielaktivität konnte nicht gespeichert werden.");
      if (activityMessage) activityMessage.textContent = "Gespeichert. Statistiken werden aktualisiert …";
      location.reload();
    } catch (error) {
      if (activityMessage) activityMessage.textContent = error instanceof Error ? error.message : "Speichern fehlgeschlagen.";
    } finally {
      activitySubmit.disabled = false;
    }
  });
</script>
