---
import Base from "../layouts/Base.astro";
import GamePlatformIcon from "../components/GamePlatformIcon.astro";
export const prerender = false;

const { token } = Astro.locals;
let games: any[] = [];

try {
  const res = await fetch(
    `http://localhost:${import.meta.env.BACKEND_PORT ?? "7331"}/games`,
    { headers: token ? { Authorization: `Bearer ${token}` } : {} },
  );
  if (res.ok) games = (await res.json()).results ?? [];
} catch {}

type PlatformKey = "playstation" | "xbox" | "steam" | "nintendo";
const PLATFORM_SECTIONS: { key: PlatformKey; label: string; color: string }[] = [
  { key: "playstation", label: "PlayStation", color: "#003791" },
  { key: "xbox", label: "Xbox", color: "#107C10" },
  { key: "steam", label: "PC", color: "#66C0F4" },
  { key: "nintendo", label: "Nintendo", color: "#E60012" },
];
function platformKey(value: string | null | undefined): PlatformKey | null {
  const name = String(value ?? "").toLowerCase();
  if (name.includes("playstation") || name.startsWith("ps")) return "playstation";
  if (name.includes("xbox")) return "xbox";
  if (name.includes("steam") || name === "pc" || name === "windows") return "steam";
  if (name.includes("nintendo") || name.includes("switch") || name.includes("wii") || name.includes("3ds") || name.includes("2ds") || name.includes("gamecube")) return "nintendo";
  return null;
}
function gamePlatforms(game: any): PlatformKey[] {
  const values = [...(game.platforms ?? []).flatMap((p: any) => [p.platform, p.platform_name]), ...(game.stats ?? []).map((s: any) => s.platform)];
  return [...new Set(values.map(platformKey).filter(Boolean))] as PlatformKey[];
}
type SortMode = "recent" | "playtime" | "title";
const sortMode = (Astro.url.searchParams.get("sort") as SortMode) || "recent";
const SORT_OPTIONS: { value: SortMode; label: string }[] = [
  { value: "recent", label: "Zuletzt gespielt" },
  { value: "playtime", label: "Längste Spieldauer" },
  { value: "title", label: "Titel" },
];
function gamePlaytime(game: any): number | null {
  const times = (game.stats ?? []).map((s: any) => Number(s.playtime_minutes)).filter((value: number) => Number.isFinite(value) && value >= 0);
  return times.length ? times.reduce((sum: number, value: number) => sum + value, 0) : null;
}
function lastPlayed(game: any): number | null {
  const dates = (game.stats ?? []).map((s: any) => Date.parse(String(s.last_played_at ?? ""))).filter((value: number) => Number.isFinite(value));
  return dates.length ? Math.max(...dates) : null;
}
function sortGames(list: any[]): any[] {
  return [...list].sort((a, b) => {
    if (sortMode === "title") return String(a.title ?? "").localeCompare(String(b.title ?? ""), undefined, { sensitivity: "base", numeric: true });
    if (sortMode === "recent") {
      const ar = lastPlayed(a), br = lastPlayed(b);
      if (ar == null && br != null) return 1;
      if (ar != null && br == null) return -1;
      if (ar != null && br != null && ar !== br) return br - ar;
    }
    if (sortMode === "playtime") {
      const at = gamePlaytime(a), bt = gamePlaytime(b);
      if (at == null && bt != null) return 1;
      if (at != null && bt == null) return -1;
      if (at != null && bt != null && at !== bt) return bt - at;
    }
    return String(a.title ?? "").localeCompare(String(b.title ?? ""), undefined, { sensitivity: "base", numeric: true });
  });
}
function formatPlaytime(minutes: number | null): string | null {
  if (minutes == null) return null;
  const hours = Math.floor(minutes / 60), remaining = minutes % 60;
  if (hours === 0) return `${remaining} Min. gespielt`;
  if (remaining === 0) return `${hours} Std. gespielt`;
  return `${hours} Std. ${remaining} Min. gespielt`;
}
const sortedGames = sortGames(games);
<Base title="Spiele">
  <div id="app-data" data-token={token} class="hidden" aria-hidden="true"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 md:py-10">
    <div class="flex items-end justify-between gap-4 flex-wrap mb-6">
      <div>
        <p class="text-[10px] font-black uppercase tracking-[.2em] text-sky-400">Spielebibliothek</p>
        <h1 class="page-title mt-2">Spiele</h1>
      </div>
      <div class="flex items-center gap-3">
        <label for="game-sort" class="text-xs font-bold uppercase tracking-wider text-zinc-600">Sortieren</label>
        <select id="game-sort" class="bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-sm font-semibold text-zinc-200 focus:outline-none focus:ring-2 focus:ring-sky-500" onchange="window.location.href='/games?sort=' + this.value">
          {SORT_OPTIONS.map((option) => <option value={option.value} selected={option.value === sortMode}>{option.label}</option>)}
        </select>
        <span class="text-sm font-bold text-zinc-500">{sortedGames.length} {sortedGames.length === 1 ? "Spiel" : "Spiele"}</span>
      </div>
    </div>

    {sortedGames.length === 0 ? (
      <div id="games-empty" class="rounded-2xl border border-dashed border-zinc-800 bg-zinc-900/40 p-14 text-center">
        <div class="mx-auto mb-5 w-16 h-16 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-600"><span class="text-3xl">🎮</span></div>
        <h2 class="text-xl font-black text-zinc-200">Noch keine Spiele</h2>
        <p class="text-sm text-zinc-500 max-w-md mx-auto mt-2">Verbinde PlayStation, Xbox, Steam oder Nintendo, oder füge ein PC-Spiel manuell hinzu.</p>
      </div>
    ) : (
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-7 gap-5">
        {sortedGames.map(game => {
          const playtime = gamePlaytime(game);
          const icons = gamePlatforms(game);
          return (
            <a href={`/game/${game.id}`} class="group min-w-0">
              <div class="aspect-[2/3] rounded-xl overflow-hidden bg-zinc-900 border border-zinc-800 group-hover:border-sky-500/60 transition shadow-lg">
                {game.cover_path ? <img src={game.cover_path} alt={game.title} class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-300" loading="lazy" /> : <div class="w-full h-full flex items-center justify-center p-4 text-center text-zinc-600 font-bold">{game.title}</div>}
              </div>
              <h3 class="mt-2 text-sm font-bold text-zinc-200 truncate group-hover:text-white">{game.title}</h3>
              <div class="mt-1.5 flex items-center gap-1.5 h-4">
                {icons.map(platform => <span title={PLATFORM_SECTIONS.find(section => section.key === platform)?.label ?? platform} class="text-zinc-500 group-hover:text-zinc-300 transition"><GamePlatformIcon platform={platform} size={15} /></span>)}
              </div>
              {playtime != null && <p class="mt-1 text-[10px] text-zinc-600">{formatPlaytime(playtime)}</p>}
            </a>
          );
        })}
      </div>
    )}

    <section id="manual-game-section" class="mt-14 rounded-2xl border border-zinc-800 bg-gradient-to-br from-zinc-900/90 to-zinc-950 p-5 sm:p-7">
      <div class="flex items-start gap-4 mb-6">
        <div class="w-11 h-11 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-300 text-xl">＋</div>
        <div>
          <p class="text-[10px] font-black uppercase tracking-[.18em] text-sky-400">Eigene Bibliothek</p>
          <h2 class="text-xl font-black text-white mt-1">PC-Spiel manuell hinzufügen</h2>
          <p class="text-sm text-zinc-500 mt-1">Für Spiele, die nicht automatisch über einen verbundenen Dienst importiert werden.</p>
        </div>
      </div>
      <form id="manual-game-form" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5">
        <label class="md:col-span-2 xl:col-span-2 text-xs font-bold text-zinc-400">Spieltitel <span class="text-rose-400">*</span>
          <input id="manual-game-title" maxlength="500" required placeholder="z. B. GTA V (Rockstar Launcher)" class="mt-2 w-full rounded-xl border border-zinc-700 bg-zinc-950/80 p-3.5 text-sm text-white placeholder:text-zinc-600 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20" />
        </label>
        <label class="md:col-span-2 xl:col-span-2 text-xs font-bold text-zinc-400">Cover <span class="font-normal text-zinc-600">JPG, PNG oder WebP · max. 5 MB</span>
          <input id="manual-game-cover" type="file" accept="image/jpeg,image/png,image/webp" class="mt-2 block w-full rounded-xl border border-zinc-700 bg-zinc-950/80 p-2.5 text-xs text-zinc-300 file:mr-3 file:rounded-lg file:border-0 file:bg-zinc-800 file:px-3 file:py-2 file:font-bold file:text-zinc-200" />
        </label>
        <div class="md:col-span-2 xl:col-span-2 rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">
          <p class="text-xs font-bold text-zinc-300 mb-3">Erfolge (optional)</p>
          <div class="grid grid-cols-2 gap-4">
            <label class="text-xs font-medium text-zinc-500">Freigeschaltet
              <input id="manual-game-achievements-earned" type="number" min="0" max="1000000" step="1" value="0" required class="mt-2 w-full rounded-lg border border-zinc-700 bg-zinc-900 p-3 text-sm font-bold text-white focus:border-sky-500 focus:outline-none" />
            </label>
            <label class="text-xs font-medium text-zinc-500">Gesamt
              <input id="manual-game-achievements-defined" type="number" min="0" max="1000000" step="1" value="0" required class="mt-2 w-full rounded-lg border border-zinc-700 bg-zinc-900 p-3 text-sm font-bold text-white focus:border-sky-500 focus:outline-none" />
            </label>
          </div>
          <p class="mt-2 text-[11px] text-zinc-600">Wenn das Spiel keine Erfolge hat, beide Werte auf 0 lassen.</p>
        </div>
        <div class="md:col-span-2 xl:col-span-2 flex flex-col justify-between gap-4">
          <p id="manual-game-message" class="text-xs text-zinc-400" role="status" aria-live="polite"></p>
          <div class="flex justify-end">
            <button id="manual-game-submit" type="submit" class="inline-flex items-center gap-2 rounded-xl bg-sky-600 hover:bg-sky-500 px-5 py-3 text-sm font-black text-white transition disabled:opacity-50">
              <span>PC-Spiel hinzufügen</span><span aria-hidden="true">→</span>
            </button>
          </div>
        </div>
      </form>
    </section>
  </div>
  <script>
    const form = document.getElementById("manual-game-form");
    const titleInput = document.getElementById("manual-game-title");
    const submit = document.getElementById("manual-game-submit");
    const message = document.getElementById("manual-game-message");
    const coverInput = document.getElementById("manual-game-cover");
    const achievementsEarned = document.getElementById("manual-game-achievements-earned");
    const achievementsDefined = document.getElementById("manual-game-achievements-defined");
    const readCover = (file) => new Promise((resolve, reject) => {
      if (!file) return resolve(null);
      if (file.size > 5 * 1024 * 1024) return reject(new Error("Das Cover darf maximal 5 MB groß sein."));
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = () => reject(new Error("Das Cover konnte nicht gelesen werden."));
      reader.readAsDataURL(file);
    });
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const title = titleInput?.value?.trim();
      if (!title) return;
      const earned = Number(achievementsEarned?.value ?? 0);
      const defined = Number(achievementsDefined?.value ?? 0);
      if (!Number.isInteger(earned) || !Number.isInteger(defined) || earned < 0 || defined < 0 || earned > defined) {
        if (message) message.textContent = "Bitte gültige Erfolge eingeben; freigeschaltet darf nicht größer als gesamt sein.";
        return;
      }
      submit.disabled = true;
      if (message) message.textContent = "Speichere …";
      try {
        const coverData = await readCover(coverInput?.files?.[0] ?? null);
        const response = await fetch("/api/proxy/games/manual", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ title, cover_data: coverData, achievements_earned: earned, achievements_defined: defined }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.detail || "PC-Spiel konnte nicht hinzugefügt werden.");
        window.location.href = data.url;
      } catch (error) {
        if (message) message.textContent = error instanceof Error ? error.message : "Hinzufügen fehlgeschlagen.";
      } finally {
        submit.disabled = false;
      }
    });
  </script>
</Base>
