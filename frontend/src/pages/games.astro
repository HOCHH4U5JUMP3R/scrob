---
import Base from "../layouts/Base.astro";
export const prerender = false;

const { token } = Astro.locals;
let games: any[] = [];

try {
  const res = await fetch(
    `http://localhost:${import.meta.env.BACKEND_PORT ?? "7331"}/games`,
    { headers: token ? { Authorization: `Bearer ${token}` } : {} },
  );
  if (res.ok) games = (await res.json()).results ?? [];
} catch {}

type PlatformKey = "playstation" | "xbox" | "steam" | "nintendo";

const PLATFORM_SECTIONS: { key: PlatformKey; label: string; color: string }[] = [
  { key: "playstation", label: "PlayStation", color: "#003791" },
  { key: "xbox", label: "Xbox", color: "#107C10" },
  { key: "steam", label: "Steam", color: "#66C0F4" },
  { key: "nintendo", label: "Nintendo", color: "#E60012" },
];

function platformKey(value: string | null | undefined): PlatformKey | null {
  const name = String(value ?? "").toLowerCase();

  if (name.includes("playstation") || name.startsWith("ps")) return "playstation";
  if (name.includes("xbox")) return "xbox";
  if (name.includes("steam")) return "steam";
  if (
    name.includes("nintendo") ||
    name.includes("switch") ||
    name.includes("wii") ||
    name.includes("3ds") ||
    name.includes("2ds") ||
    name.includes("gamecube")
  ) return "nintendo";

  return null;
}

function gamePlatforms(game: any): PlatformKey[] {
  const values = [
    ...(game.platforms ?? []).flatMap((p: any) => [p.platform, p.platform_name]),
    ...(game.stats ?? []).map((s: any) => s.platform),
  ];

  return [...new Set(values.map(platformKey).filter(Boolean))] as PlatformKey[];
}

function playtimeFor(game: any, section: PlatformKey): number | null {
  const stats = (game.stats ?? []).filter((s: any) => platformKey(s.platform) === section);
  const times = stats
    .map((s: any) => Number(s.playtime_minutes))
    .filter((value: number) => Number.isFinite(value) && value >= 0);

  if (!times.length) return null;
  return times.reduce((sum: number, value: number) => sum + value, 0);
}

type SortMode = "recent" | "playtime" | "title";
const sortMode = (Astro.url.searchParams.get("sort") as SortMode) || "recent";
const SORT_OPTIONS: { value: SortMode; label: string }[] = [
  { value: "recent", label: "Zuletzt gespielt" },
  { value: "playtime", label: "Längste Spieldauer" },
  { value: "title", label: "Titel" },
];

function lastPlayedFor(game: any, section: PlatformKey): number | null {
  const dates = (game.stats ?? []).filter((s: any) => platformKey(s.platform) === section).map((s: any) => Date.parse(String(s.last_played_at ?? ""))).filter((value: number) => Number.isFinite(value));
  return dates.length ? Math.max(...dates) : null;
}

function sortGames(list: any[], section: PlatformKey): any[] {
  return [...list].sort((a, b) => {
    if (sortMode === "title") return String(a.title ?? "").localeCompare(String(b.title ?? ""), undefined, { sensitivity: "base", numeric: true });
    if (sortMode === "recent") {
      const aRecent = lastPlayedFor(a, section); const bRecent = lastPlayedFor(b, section);
      if (aRecent == null && bRecent != null) return 1;
      if (aRecent != null && bRecent == null) return -1;
      if (aRecent != null && bRecent != null && aRecent !== bRecent) return bRecent - aRecent;
    }
    if (sortMode === "playtime") {
      const aTime = playtimeFor(a, section); const bTime = playtimeFor(b, section);
      if (aTime == null && bTime != null) return 1;
      if (aTime != null && bTime == null) return -1;
      if (aTime != null && bTime != null && aTime !== bTime) return bTime - aTime;
    }
    return String(a.title ?? "").localeCompare(String(b.title ?? ""), undefined, { sensitivity: "base", numeric: true });
  });
}

function formatPlaytime(minutes: number | null): string | null {
  if (minutes == null) return null;
  const hours = Math.floor(minutes / 60);
  const remaining = minutes % 60;

  if (hours === 0) return `${remaining}m played`;
  if (remaining === 0) return `${hours}h played`;
  return `${hours}h ${remaining}m played`;
}

function platformIcon(platform: PlatformKey, size = 18): string {
  const paths: Record<PlatformKey, string> = {
    playstation:
      "M8.984 2.596v17.547l3.915 1.261V6.688c0-.69.304-1.151.794-.991.636.18.76.814.76 1.505v5.875c2.441 1.193 4.362-.002 4.362-3.152 0-3.237-1.126-4.675-4.438-5.827-1.307-.448-3.728-1.186-5.39-1.502zm4.656 16.241 6.296-2.275c.715-.258.826-.625.246-.818-.586-.192-1.637-.139-2.357.123l-4.205 1.5V14.98l.24-.085s1.201-.42 2.913-.615c1.696-.18 3.785.03 5.437.661 1.848.601 2.04 1.472 1.576 2.072-.465.6-1.622 1.036-1.622 1.036l-8.544 3.107V18.86zM1.807 18.6c-1.9-.545-2.214-1.668-1.352-2.32.801-.586 2.16-1.052 2.16-1.052l5.615-2.013v2.313L4.205 17c-.705.271-.825.632-.239.826.586.195 1.637.15 2.343-.12L8.247 17v2.074c-.12.03-.256.044-.39.073-1.939.331-3.996.196-6.038-.479z",
    xbox:
      "M4.102 21.033A11.95 11.95 0 0 0 12 24a11.96 11.96 0 0 0 7.902-2.967c1.877-1.912-4.316-8.709-7.902-11.417-3.582 2.708-9.779 9.505-7.898 11.417m11.16-14.406c2.5 2.961 7.484 10.313 6.076 12.912A11.94 11.94 0 0 0 24 12.004a11.95 11.95 0 0 0-3.57-8.536s-.027-.022-.082-.042a.8.8 0 0 0-.281-.045c-.592 0-1.985.434-4.805 3.246M3.654 3.426c-.057.02-.082.042-.086.042A11.96 11.96 0 0 0 0 12.004c0 2.854.998 5.473 2.661 7.533-1.401-2.605 3.579-9.951 6.08-12.91-2.82-2.813-4.216-3.245-4.806-3.245a.7.7 0 0 0-.281.046zM12 3.551S9.055 1.828 6.755 1.746c-.903-.033-1.454.295-1.521.339C7.379.646 9.659 0 11.984 0H12c2.334 0 4.605.646 6.766 2.085-.068-.046-.615-.372-1.52-.339C14.946 1.828 12 3.545 12 3.545z",
    steam:
      "M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265z",
    nintendo:
      "M0 .6h7.1l9.85 15.9V.6H24v22.8h-7.04L7.06 7.5v15.9H0V.6Z",
  };

  return `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="currentColor" aria-hidden="true"><path d="${paths[platform]}"/></svg>`;
}

const sections = PLATFORM_SECTIONS
  .map((section) => ({
    ...section,
    games: sortGames(games.filter((game) => gamePlatforms(game).includes(section.key)), section.key),
  }))
  .filter((section) => section.games.length > 0);
---
<Base title="Games">
  <div id="app-data" data-token={token} class="hidden" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 md:py-10">
    <div class="flex items-end justify-between gap-4 flex-wrap mb-10">
      <div>
        <p class="text-[10px] font-black uppercase tracking-[.2em] text-sky-400">Gaming</p>
        <h1 class="page-title mt-2">Games</h1>
        <p class="text-sm text-zinc-500 mt-2">Your games across PlayStation, Xbox, Steam and Nintendo.</p>
      </div>
      <div class="flex items-center gap-3">
        <label for="game-sort" class="text-xs font-bold uppercase tracking-wider text-zinc-600">Sortieren</label>
        <select id="game-sort" class="bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-2 text-sm font-semibold text-zinc-200 focus:outline-none focus:ring-2 focus:ring-sky-500" onchange="window.location.href='/games?sort=' + this.value">
          {SORT_OPTIONS.map((option) => (
            <option value={option.value} selected={option.value === sortMode}>{option.label}</option>
          ))}
        </select>
        <span class="text-sm font-bold text-zinc-500">{games.length} {games.length === 1 ? "game" : "games"}</span>
      </div>
    </div>

    {games.length === 0 ? (
      <div id="games-empty" class="rounded-2xl border border-dashed border-zinc-800 bg-zinc-900/40 p-14 text-center">
        <div class="mx-auto mb-5 w-16 h-16 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-600">
          <span class="text-3xl">🎮</span>
        </div>
        <h2 class="text-xl font-black text-zinc-200">No games yet</h2>
        <p class="text-sm text-zinc-500 max-w-md mx-auto mt-2">Connect PlayStation, Xbox, Steam or Nintendo and the unified game library will appear here.</p>
      </div>
    ) : (
      <div class="space-y-12">
        {sections.map(section => (
          <section>
            <div class="flex items-center gap-3 mb-5">
              <div
                class="w-10 h-10 rounded-xl bg-zinc-900 border border-zinc-800 flex items-center justify-center"
                style={`color: ${section.color}`}
              >
                <span set:html={platformIcon(section.key, 23)}></span>
              </div>
              <div>
                <h2 class="text-xl font-black text-zinc-100">{section.label}</h2>
                <p class="text-xs text-zinc-600">{section.games.length} {section.games.length === 1 ? "game" : "games"} · {SORT_OPTIONS.find((option) => option.value === sortMode)?.label}</p>
              </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-7 gap-5">
              {section.games.map(game => {
                const playtime = playtimeFor(game, section.key);
                const icons = gamePlatforms(game);

                return (
                  <a href={`/game/${game.id}`} class="group min-w-0">
                    <div class="aspect-[2/3] rounded-xl overflow-hidden bg-zinc-900 border border-zinc-800 group-hover:border-zinc-600 transition shadow-lg">
                      {game.cover_path ? (
                        <img
                          src={game.cover_path}
                          alt={game.title}
                          class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-300"
                          loading="lazy"
                        />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center p-4 text-center text-zinc-600 font-bold">
                          {game.title}
                        </div>
                      )}
                    </div>

                    <h3 class="mt-2 text-sm font-bold text-zinc-200 truncate group-hover:text-white">{game.title}</h3>

                    <div class="mt-1.5 flex items-center gap-1.5 h-4">
                      {icons.map(platform => (
                        <span
                          title={PLATFORM_SECTIONS.find(section => section.key === platform)?.label ?? platform}
                          class="text-zinc-500 group-hover:text-zinc-300 transition"
                          set:html={platformIcon(platform, 15)}
                        ></span>
                      ))}
                    </div>

                    {playtime != null && (
                      <p class="mt-1 text-[10px] text-zinc-600">{formatPlaytime(playtime)}</p>
                    )}
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    )}
  </div>
</Base>
