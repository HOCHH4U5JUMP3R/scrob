---
import Base from "../../layouts/Base.astro";
export const prerender = false;

const { id } = Astro.params;
const { token, user: currentUser } = Astro.locals;

// Lightweight privacy pre-check — reuses the same endpoint, only reads the status code.
// If 403/404, we show the appropriate error shell without loading any stats.
let accessError = "";

try {
  const res = await fetch(
    `http://localhost:${import.meta.env.BACKEND_PORT ?? "7331"}/profile/${id}`,
    token ? { headers: { Authorization: `Bearer ${token}` } } : {}
  );
  if (res.status === 404) accessError = "User not found.";
  else if (res.status === 403) accessError = "This profile is private.";
  else if (!res.ok) accessError = "Failed to load profile.";
} catch {
  accessError = "Failed to load profile.";
}

const isOwnStats = currentUser && String(currentUser.id) === String(id);
---


<Base title="Statistics">
  {accessError ? (
    <div class="max-w-md mx-auto mt-20 text-center">
      <div class="bg-zinc-900/50 border border-zinc-800 p-10 rounded-3xl">
        <div class="w-20 h-20 bg-zinc-800 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-500"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h2 class="text-2xl font-black text-zinc-100 mb-2">Access Restricted</h2>
        <p class="text-zinc-400 font-medium mb-8">{accessError}</p>
        <a href="/" class="px-6 py-3 bg-sky-600 hover:bg-sky-500 text-white font-black rounded-xl transition-all inline-block">Return Home</a>
      </div>
    </div>
  ) : (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 md:py-10 stats-page">
      <header class="stats-hero mb-8">
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <div>
            <a href={`/profile/${id}`} class="back-link">← Profile</a>
            <p class="eyebrow mt-5">Your media recap</p>
            <h1 class="page-title mt-1">Your watching story</h1>
            <p class="hero-copy">A complete look at what you watched, rated and collected.</p>
          </div>
          <div class="period-control">
            <label for="period-select">Period</label>
            <select id="period-select">
              <option value="all">All time</option><option value="today">Today</option><option value="yesterday">Yesterday</option>
              <option value="week">This week</option><option value="lastweek">Last week</option><option value="month">This month</option>
              <option value="lastmonth">Last month</option><option value="year">This year</option><option value="lastyear">Last year</option>
              <option value="last7">Last 7 days</option><option value="last30">Last 30 days</option><option value="last90">Last 90 days</option>
              <option value="last365">Last 365 days</option><option value="custom">Custom range…</option>
            </select>
            <div id="custom-range" class="hidden items-center gap-2 mt-2">
              <input id="custom-since" type="date"><span>–</span><input id="custom-until" type="date">
              <button id="custom-apply">Apply</button>
            </div>
          </div>
        </div>
      </header>

      <main id="stats-content" class="space-y-8">
        <section id="summary-row" class="kpi-grid">
          {[...Array(4)].map(() => <div class="kpi-card animate-pulse"><div class="skeleton h-9 w-20"></div><div class="skeleton h-3 w-28 mt-3"></div></div>)}
        </section>

        <section class="feature-grid">
          <div class="panel activity-panel">
            <div class="panel-heading"><div><p class="eyebrow">Watching</p><h2>Activity over time</h2></div><span class="panel-badge">Movies + Episodes</span></div>
            <div id="activity-chart" class="chart-lg animate-pulse"></div>
          </div>
          <div class="panel time-panel">
            <div class="panel-heading"><div><p class="eyebrow">Time spent</p><h2>Watch time</h2></div></div>
            <div id="watch-time-breakdown" class="metric-stack animate-pulse"><div class="skeleton h-12"></div><div class="skeleton h-12"></div></div>
            <div id="watch-time-chart" class="chart-sm animate-pulse"></div>
          </div>
        </section>

        <section class="section-block">
          <div class="section-title"><div><p class="eyebrow">Taste</p><h2>What you like to watch</h2></div></div>
          <div class="taste-grid">
            <div class="panel"><h3>Most watched genres</h3><div id="genres-container" class="genre-columns animate-pulse"><div class="skeleton h-40"></div><div class="skeleton h-40"></div></div></div>
            <div class="panel"><h3>Rating distribution</h3><div id="rating-chart" class="chart-md animate-pulse"></div></div>
            <div class="panel"><h3>Average ratings</h3><div id="avg-ratings" class="metric-stack animate-pulse"><div class="skeleton h-12"></div><div class="skeleton h-12"></div></div></div>
            <div class="panel"><h3 id="weekday-chart-title">Average activity by day</h3><div id="weekday-chart" class="chart-md animate-pulse"></div></div>
          </div>
        </section>

        <section id="game-stats" class="section-block" style="display:none">
          <div class="section-title"><div><p class="eyebrow">Gaming</p><h2>Game statistics</h2></div><span class="panel-badge">All platforms</span></div>
          <div class="kpi-grid mb-6">
            <div class="kpi-card"><div id="game-count" class="kpi-value">0</div><div class="kpi-label">Games played</div></div>
            <div class="kpi-card"><div id="game-time" class="kpi-value">0h</div><div class="kpi-label">Play time</div></div>
            <div class="kpi-card"><div id="game-plays" class="kpi-value">0</div><div class="kpi-label">Play sessions</div></div>
            <div class="kpi-card"><div id="game-achievements" class="kpi-value">0%</div><div class="kpi-label">Achievement completion</div></div>
          </div>
          <div class="game-stats-grid">
            <div class="panel"><h3>Platforms</h3><div id="game-platforms" class="metric-stack"></div></div>
            <div class="panel poster-panel"><h3>Most played games</h3><div id="top-games" class="poster-grid"></div></div>
          </div>
        </section>

        <section id="top-stats" class="section-block" style="display:none">
          <div class="section-title"><div><p class="eyebrow">Your favourites</p><h2>Most watched</h2></div></div>
          <div class="top-grid">
            <div class="panel poster-panel" id="top-shows-card"><h3>Top shows</h3><div id="top-shows" class="poster-grid"></div></div>
            <div class="panel poster-panel" id="top-movies-card"><h3>Top movies</h3><div id="top-movies" class="poster-grid"></div></div>
            <div class="panel" id="top-networks-card"><h3>Favourite networks</h3><div id="top-networks" class="chip-grid"></div></div>
            <div class="panel" id="top-actors-card"><h3>Most watched actors</h3><div id="top-actors" class="chip-grid"></div></div>
            <div class="panel" id="top-directors-card"><h3>Favourite directors</h3><div id="top-directors" class="chip-grid"></div></div>
            <div class="panel" id="top-writers-card"><h3>Favourite writers</h3><div id="top-writers" class="chip-grid"></div></div>
            <div class="panel" id="top-studios-card"><h3>Favourite studios</h3><div id="top-studios" class="chip-grid"></div></div>
          </div>
        </section>

        <section class="section-block">
          <div class="section-title"><div><p class="eyebrow">Library</p><h2>Your collection</h2></div></div>
          <div class="collection-grid">
            <div class="panel"><h3>Collection breakdown</h3><div id="collection-breakdown" class="metric-stack animate-pulse"><div class="skeleton h-12"></div><div class="skeleton h-12"></div><div class="skeleton h-12"></div></div></div>
            <div class="panel"><h3>Watched vs unwatched</h3><div id="collection-pies" class="pie-grid animate-pulse">{[...Array(3)].map(() => <div class="skeleton rounded-full w-24 h-24 mx-auto"></div>)}</div></div>
          </div>
        </section>
      </main>
    </div>
  )}
</Base>

<style>
.game-stats-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:1.25rem}.game-stats-grid .panel{min-width:0}@media(max-width:900px){.game-stats-grid{grid-template-columns:1fr}}
.stats-page{--border:rgba(63,63,70,.72);--muted:#71717a;--panel:rgba(18,18,21,.78);--panel2:rgba(24,24,27,.88)}
.stats-page .stats-hero{padding:1.25rem 0 0}.back-link{font-size:.7rem;font-weight:800;color:#71717a;text-transform:uppercase;letter-spacing:.12em}.back-link:hover{color:#d4d4d8}
.stats-page .eyebrow{font-size:.65rem;font-weight:900;letter-spacing:.18em;text-transform:uppercase;color:#38bdf8}.hero-copy{color:#71717a;font-size:.9rem;margin-top:.55rem}
.stats-page .page-title{font-size:clamp(2rem,5vw,3.5rem);line-height:.98;font-weight:950;letter-spacing:-.045em;color:#f4f4f5}
.period-control{min-width:190px}.period-control label{display:block;color:#71717a;font-size:.62rem;font-weight:900;text-transform:uppercase;letter-spacing:.15em;margin-bottom:.45rem}
.period-control select,.period-control input{background:rgba(24,24,27,.95);border:1px solid var(--border);color:#e4e4e7;border-radius:.8rem;padding:.65rem .8rem;font-size:.8rem;font-weight:800;outline:0}.period-control select{width:100%}.period-control button{background:#0284c7;color:white;border:0;border-radius:.7rem;padding:.6rem .8rem;font-size:.75rem;font-weight:900}
.kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem}.kpi-card{min-height:128px;padding:1.35rem;border:1px solid var(--border);border-radius:1.15rem;background:linear-gradient(145deg,rgba(30,41,59,.7),var(--panel));display:flex;flex-direction:column;justify-content:center;box-shadow:0 18px 45px rgba(0,0,0,.12)}
.kpi-card p:first-child{font-size:2rem!important;font-weight:950!important;letter-spacing:-.04em}.kpi-card p:last-child{color:#71717a!important;font-size:.65rem!important;font-weight:900!important;letter-spacing:.14em;text-transform:uppercase}
.feature-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(300px,.8fr);gap:1rem}.taste-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.top-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.collection-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:1rem}
.panel{border:1px solid var(--border);border-radius:1.15rem;background:linear-gradient(145deg,var(--panel2),var(--panel));padding:1.25rem;box-shadow:0 18px 50px rgba(0,0,0,.12);min-width:0}.panel:hover{border-color:rgba(113,113,122,.7)}
.panel-heading,.section-title{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem}.panel h2,.section-title h2{font-size:1.35rem;font-weight:900;letter-spacing:-.025em;color:#f4f4f5;margin-top:.2rem}.panel h3{font-size:.68rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:#a1a1aa;margin-bottom:1rem}.panel-badge{font-size:.6rem;font-weight:900;text-transform:uppercase;letter-spacing:.1em;color:#71717a;border:1px solid var(--border);border-radius:999px;padding:.4rem .65rem}
.section-block{padding-top:.5rem}.section-title{margin-bottom:1rem}.chart-lg{height:250px}.chart-md{height:170px}.chart-sm{height:135px;margin-top:1rem}.metric-stack{display:grid;gap:.55rem}.metric-stack>div:not(.skeleton){border:1px solid rgba(63,63,70,.5);background:rgba(39,39,42,.3);border-radius:.8rem}
.genre-columns{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.poster-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.8rem}.chip-grid{display:flex;flex-wrap:wrap;gap:.45rem}.pie-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;align-items:center}
.skeleton{background:linear-gradient(90deg,rgba(39,39,42,.5),rgba(63,63,70,.5),rgba(39,39,42,.5));border-radius:.7rem;animation:pulse 1.5s infinite}@keyframes pulse{50%{opacity:.45}}
.stats-page #stats-content{transition:opacity .15s ease}.stats-page img{background:#27272a}
@media(max-width:900px){.kpi-grid{grid-template-columns:repeat(2,1fr)}.feature-grid,.taste-grid,.top-grid,.collection-grid{grid-template-columns:1fr}.poster-grid{grid-template-columns:repeat(4,1fr)}}
@media(max-width:560px){.stats-page{padding-left:1rem;padding-right:1rem}.kpi-card{min-height:100px;padding:1rem}.kpi-card p:first-child{font-size:1.55rem!important}.period-control{width:100%}.poster-grid{grid-template-columns:repeat(3,1fr)}.genre-columns{grid-template-columns:1fr}.pie-grid{gap:.4rem}}
</style>
<script define:vars={{ userId: id, token, isOwnStats }}>
  // ── State ──────────────────────────────────────────────────────────────────
  let currentPeriod = 'all';

  // ── Period computation ─────────────────────────────────────────────────────
  const _fmt = d => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  const _short = d => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

  function computeRange(period) {
    const today = new Date(); today.setHours(0,0,0,0);
    const addDays = (d,n) => { const x=new Date(d); x.setDate(x.getDate()+n); return x; };
    const range = (s,u,label) => ({ since:_fmt(s), until:_fmt(u), label });

    if(period==='all') return {since:null,until:null,label:'All time'};
    if(period==='today') return range(today,today,'Today');
    if(period==='yesterday') { const d=addDays(today,-1); return range(d,d,'Yesterday'); }

    if(period==='week'||period==='lastweek') {
      const dow=today.getDay();
      const monday=addDays(today,dow===0?-6:1-dow);
      const start=period==='lastweek'?addDays(monday,-7):monday;
      return range(start,addDays(start,6),period==='week'?'This week':'Last week');
    }
    if(period==='month'||period==='lastmonth') {
      const start=new Date(today.getFullYear(),today.getMonth()+(period==='lastmonth'?-1:0),1);
      const end=new Date(start.getFullYear(),start.getMonth()+1,0);
      return range(start,end,start.toLocaleDateString('en-US',{month:'long',year:'numeric'}));
    }
    if(period==='year'||period==='lastyear') {
      const year=today.getFullYear()+(period==='lastyear'?-1:0);
      return range(new Date(year,0,1),new Date(year,11,31),String(year));
    }
    if(period==='last7'||period==='last30'||period==='last90'||period==='last365') {
      const days=Number(period.replace('last',''));
      return range(addDays(today,-(days-1)),today,`Last ${days} days`);
    }
    if(period==='custom') {
      const s=document.getElementById('custom-since')?.value||'';
      const u=document.getElementById('custom-until')?.value||'';
      if(!s||!u||s>u) return {since:null,until:null,label:'Choose a valid date range'};
      return {since:s,until:u,label:`${_short(new Date(s+'T00:00:00'))} – ${_short(new Date(u+'T00:00:00'))}`};
    }
    return {since:null,until:null,label:'All time'};
  }

  // ── Helpers ────────────────────────────────────────────────────────────────
  function formatMinutes(mins) {
    const h = Math.round(mins / 60);
    return h >= 48 ? `${(mins / 60 / 24).toFixed(1)}d` : `${h}h`;
  }

  const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const dayNames   = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

  function fillActivityGaps(activityData, since, until, isDaily) {
    if (!since || !until) return activityData;
    const dataMap = Object.fromEntries(activityData.map(d => [d.month, d]));
    const filled = [];
    if (isDaily) {
      const cur = new Date(since); cur.setHours(0,0,0,0);
      const end = new Date(until); end.setHours(0,0,0,0);
      while (cur <= end) {
        const key = _fmt(cur);
        filled.push(dataMap[key] || { month: key, movies: 0, episodes: 0 });
        cur.setDate(cur.getDate() + 1);
      }
    } else {
      const [sy, sm] = since.split('-').map(Number);
      const [uy, um] = until.split('-').map(Number);
      let cy = sy, cm = sm;
      while (cy < uy || (cy === uy && cm <= um)) {
        const key = `${cy}-${String(cm).padStart(2,'0')}`;
        filled.push(dataMap[key] || { month: key, movies: 0, episodes: 0 });
        if (++cm > 12) { cm = 1; cy++; }
      }
    }
    return filled;
  }

  function getActivityLabel(d, isDaily, totalBars) {
    if (!isDaily) return monthNames[parseInt(d.month.slice(5), 10) - 1];
    const [y, m, day] = d.month.split('-').map(Number);
    if (totalBars <= 7) return dayNames[new Date(y, m-1, day).getDay()];
    return [1, 5, 10, 15, 20, 25].includes(day) ? String(day) : '';
  }

  // ── Loading state ──────────────────────────────────────────────────────────
  function setLoading(on) {
    const el = document.getElementById('stats-content');
    if (!el) return;
    el.style.opacity = on ? '0.4' : '';
    el.style.pointerEvents = on ? 'none' : '';
    el.style.transition = 'opacity 0.15s';
  }

  // ── Render ─────────────────────────────────────────────────────────────────
  function renderStats(data, since, until) {
    const totalH = Math.round(data.total_watch_minutes / 60);
    const totalD = (data.total_watch_minutes / 60 / 24).toFixed(1);

    // Summary row
    const summaryRow = document.getElementById('summary-row');
    if (summaryRow) {
      summaryRow.innerHTML = [
        { value: data.movies_watched.toLocaleString(),   label: 'Movies Watched' },
        { value: data.shows_watched.toLocaleString(),    label: 'Shows Watched' },
        { value: data.episodes_watched.toLocaleString(), label: 'Episodes Watched' },
        { value: totalH >= 48 ? `${totalD}d` : `${totalH}h`, label: 'Watch Time' },
      ].map(({ value, label }) => `
        <div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-5 text-center">
          <p class="text-3xl font-black text-zinc-100 tracking-tight">${value}</p>
          <p class="text-xs text-zinc-500 font-bold uppercase tracking-widest mt-1">${label}</p>
        </div>
      `).join('');
    }

    // Activity chart
    const isDaily = data.granularity === 'day';
    const activityChart = document.getElementById('activity-chart');
    if (activityChart) {
      let activityData = since && until
        ? fillActivityGaps(data.watch_activity, since, until, isDaily)
        : data.watch_activity.slice(-24);
      activityChart.classList.remove('animate-pulse', 'bg-zinc-800/50', 'rounded-xl');
      if (activityData.length > 0 && activityData.some(d => d.movies + d.episodes > 0)) {
        const maxVal = Math.max(...activityData.map(d => d.movies + d.episodes), 1);
        activityChart.style.display = 'flex';
        activityChart.style.flexDirection = 'column';
        
        const barMinWidth = isDaily ? (activityData.length > 90 ? 4 : 10) : 32;
        
        activityChart.innerHTML = `
          <div id="activity-info" style="height:18px;margin-bottom:4px;display:flex;align-items:center">
            <span id="activity-info-text" style="font-size:11px;font-weight:700;color:#a1a1aa"></span>
          </div>
          <div class="overflow-x-auto scrollbar-none" style="flex:1;min-height:0">
            <div style="display:flex;flex-direction:column;min-width:max-content;height:100%;padding-bottom:4px">
              <div style="flex:1;display:flex;align-items:flex-end;gap:2px;min-height:0">
                ${activityData.map(d => {
                  const total = d.movies + d.episodes;
                  const pct = (total / maxVal) * 100;
                  const moviePct = total > 0 ? (d.movies / total) * 100 : 50;
                  const parts = d.month.split('-').map(Number);
                  const barLabel = isDaily
                    ? `${monthNames[parts[1]-1]}. ${parts[2]}, ${parts[0]}`
                    : `${monthNames[parts[1]-1]}. ${parts[0]}`;
                  return `
                    <div data-info="${barLabel}: ${d.movies} Movies, ${d.episodes} Episodes" style="flex:1;min-width:${barMinWidth}px;height:100%;display:flex;flex-direction:column;justify-content:flex-end">
                      <div style="height:${total > 0 ? Math.max(pct, 2) : 0}%;width:100%;border-radius:3px 3px 0 0;overflow:hidden;display:flex;flex-direction:column">
                        <div style="flex:${moviePct};background:rgba(14,165,233,0.8)"></div>
                        <div style="flex:${100-moviePct};background:rgba(168,85,247,0.8)"></div>
                      </div>
                    </div>
                  `;
                }).join('')}
              </div>
              <div style="display:flex;gap:2px;margin-top:4px">
                ${activityData.map(d => {
                  const label = getActivityLabel(d, isDaily, activityData.length);
                  return `<div style="flex:1;min-width:${barMinWidth}px;text-align:center"><span style="font-size:9px;font-weight:700;color:#52525b;text-transform:uppercase;letter-spacing:.04em">${label}</span></div>`;
                }).join('')}
              </div>
            </div>
          </div>
          <div style="display:flex;gap:16px;margin-top:10px;padding-top:8px;border-top:1px solid rgba(39,39,42,0.4)">
            <span style="display:flex;align-items:center;gap:6px;font-size:10px;font-weight:700;color:#71717a;text-transform:uppercase;letter-spacing:.1em"><span style="width:8px;height:8px;border-radius:2px;background:rgba(14,165,233,0.8);display:inline-block"></span>Movies</span>
            <span style="display:flex;align-items:center;gap:6px;font-size:10px;font-weight:700;color:#71717a;text-transform:uppercase;letter-spacing:.1em"><span style="width:8px;height:8px;border-radius:2px;background:rgba(168,85,247,0.8);display:inline-block"></span>Episodes</span>
          </div>
        `;
        const infoText = document.getElementById('activity-info-text');
        activityChart.addEventListener('mouseover', e => {
          const bar = e.target.closest('[data-info]');
          if (bar && infoText) infoText.textContent = bar.dataset.info;
        });
        activityChart.addEventListener('mouseleave', () => {
          if (infoText) infoText.textContent = '';
        });
        activityChart.addEventListener('touchstart', e => {
          const bar = e.target.closest('[data-info]');
          if (bar && infoText) infoText.textContent = bar.dataset.info;
        }, { passive: true });
      } else {
        activityChart.innerHTML = '<p style="color:#52525b;font-size:14px;font-weight:500;text-align:center;padding-top:40px">No watch history for the selected period.</p>';
      }
    }

    // Watch time chart
    const watchTimeChart = document.getElementById('watch-time-chart');
    if (watchTimeChart) {
      let wtData = since && until
        ? (() => {
            const dataMap = Object.fromEntries((data.watch_time_activity || []).map(d => [d.month, d]));
            const filled = [];
            if (isDaily) {
              const cur = new Date(since); cur.setHours(0,0,0,0);
              const end = new Date(until); end.setHours(0,0,0,0);
              while (cur <= end) {
                const key = _fmt(cur);
                filled.push(dataMap[key] || { month: key, movie_minutes: 0, show_minutes: 0 });
                cur.setDate(cur.getDate() + 1);
              }
            } else {
              const [sy, sm] = since.split('-').map(Number);
              const [uy, um] = until.split('-').map(Number);
              let cy = sy, cm = sm;
              while (cy < uy || (cy === uy && cm <= um)) {
                const key = `${cy}-${String(cm).padStart(2,'0')}`;
                filled.push(dataMap[key] || { month: key, movie_minutes: 0, show_minutes: 0 });
                if (++cm > 12) { cm = 1; cy++; }
              }
            }
            return filled;
          })()
        : (data.watch_time_activity || []).slice(-24);

      watchTimeChart.classList.remove('animate-pulse', 'bg-zinc-800/50', 'rounded-xl');

      const fmtTime = (mins) => {
        if (!mins) return '0m';
        const h = Math.floor(mins / 60), m = mins % 60;
        return h > 0 ? (m > 0 ? `${h}h ${m}m` : `${h}h`) : `${m}m`;
      };

      if (wtData.length > 0 && wtData.some(d => d.movie_minutes + d.show_minutes > 0)) {
        const maxVal = Math.max(...wtData.map(d => d.movie_minutes + d.show_minutes), 1);
        const barMinWidth = isDaily ? (wtData.length > 90 ? 4 : 10) : 32;
        watchTimeChart.style.display = 'flex';
        watchTimeChart.style.flexDirection = 'column';
        watchTimeChart.innerHTML = `
          <div id="wt-info" style="height:18px;margin-bottom:4px;display:flex;align-items:center">
            <span id="wt-info-text" style="font-size:11px;font-weight:700;color:#a1a1aa"></span>
          </div>
          <div class="overflow-x-auto scrollbar-none" style="flex:1;min-height:0">
            <div style="display:flex;flex-direction:column;min-width:max-content;height:100%;padding-bottom:4px">
              <div style="flex:1;display:flex;align-items:flex-end;gap:2px;min-height:0">
                ${wtData.map(d => {
                  const total = d.movie_minutes + d.show_minutes;
                  const pct = (total / maxVal) * 100;
                  const moviePct = total > 0 ? (d.movie_minutes / total) * 100 : 50;
                  const parts = d.month.split('-').map(Number);
                  const barLabel = isDaily
                    ? `${monthNames[parts[1]-1]}. ${parts[2]}, ${parts[0]}`
                    : `${monthNames[parts[1]-1]}. ${parts[0]}`;
                  const tooltip = `${barLabel}: ${fmtTime(total)} total · ${fmtTime(d.movie_minutes)} movies · ${fmtTime(d.show_minutes)} shows`;
                  return `
                    <div data-info="${tooltip}" style="flex:1;min-width:${barMinWidth}px;height:100%;display:flex;flex-direction:column;justify-content:flex-end">
                      <div style="height:${total > 0 ? Math.max(pct, 2) : 0}%;width:100%;border-radius:3px 3px 0 0;overflow:hidden;display:flex;flex-direction:column">
                        <div style="flex:${moviePct};background:rgba(14,165,233,0.8)"></div>
                        <div style="flex:${100-moviePct};background:rgba(168,85,247,0.8)"></div>
                      </div>
                    </div>
                  `;
                }).join('')}
              </div>
              <div style="display:flex;gap:2px;margin-top:4px">
                ${wtData.map(d => {
                  const label = getActivityLabel(d, isDaily, wtData.length);
                  return `<div style="flex:1;min-width:${barMinWidth}px;text-align:center"><span style="font-size:9px;font-weight:700;color:#52525b;text-transform:uppercase;letter-spacing:.04em">${label}</span></div>`;
                }).join('')}
              </div>
            </div>
          </div>
          <div style="display:flex;gap:16px;margin-top:10px;padding-top:8px;border-top:1px solid rgba(39,39,42,0.4)">
            <span style="display:flex;align-items:center;gap:6px;font-size:10px;font-weight:700;color:#71717a;text-transform:uppercase;letter-spacing:.1em"><span style="width:8px;height:8px;border-radius:2px;background:rgba(14,165,233,0.8);display:inline-block"></span>Movies</span>
            <span style="display:flex;align-items:center;gap:6px;font-size:10px;font-weight:700;color:#71717a;text-transform:uppercase;letter-spacing:.1em"><span style="width:8px;height:8px;border-radius:2px;background:rgba(168,85,247,0.8);display:inline-block"></span>Shows</span>
          </div>
        `;
        const wtInfoText = document.getElementById('wt-info-text');
        watchTimeChart.addEventListener('mouseover', e => {
          const bar = e.target.closest('[data-info]');
          if (bar && wtInfoText) wtInfoText.textContent = bar.dataset.info;
        });
        watchTimeChart.addEventListener('mouseleave', () => {
          if (wtInfoText) wtInfoText.textContent = '';
        });
        watchTimeChart.addEventListener('touchstart', e => {
          const bar = e.target.closest('[data-info]');
          if (bar && wtInfoText) wtInfoText.textContent = bar.dataset.info;
        }, { passive: true });
      } else {
        watchTimeChart.innerHTML = '<p style="color:#52525b;font-size:14px;font-weight:500;text-align:center;padding-top:40px">No watch time data for the selected period.</p>';
      }
    }

    // Rating distribution
    const ratingChart = document.getElementById('rating-chart');
    if (ratingChart) {
      const hasRatings = data.rating_distribution.length > 0;
      if (hasRatings) {
        const ratingMap = new Map();
        for (let r = 1; r <= 10; r++) ratingMap.set(r, 0);
        data.rating_distribution.forEach(d => ratingMap.set(d.rating, d.count));
        const fullDist = Array.from(ratingMap, ([rating, count]) => ({ rating, count }));
        const maxCount = Math.max(...fullDist.map(d => d.count), 1);
        ratingChart.classList.remove('animate-pulse', 'bg-zinc-800/50', 'rounded-xl');
        ratingChart.style.display = 'flex';
        ratingChart.style.flexDirection = 'column';
        ratingChart.innerHTML = `
          <div style="flex:1;display:flex;align-items:flex-end;gap:4px;min-height:0">
            ${fullDist.map(d => {
              const pct = (d.count / maxCount) * 100;
              return `
                <div style="flex:1;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center">
                  <span style="font-size:9px;font-weight:800;color:${d.count > 0 ? 'rgba(245,158,11,0.85)' : 'transparent'};margin-bottom:2px;line-height:1">${d.count > 0 ? d.count : '0'}</span>
                  <div style="height:${d.count > 0 ? Math.max(pct, 3) : 2}%;width:100%;background:${d.count > 0 ? 'rgba(245,158,11,0.7)' : 'rgba(63,63,70,0.4)'};border-radius:3px 3px 0 0"></div>
                </div>
              `;
            }).join('')}
          </div>
          <div style="display:flex;gap:4px;margin-top:4px">
            ${fullDist.map(d => `<div style="flex:1;text-align:center"><span style="font-size:9px;color:#52525b;font-weight:700;white-space:nowrap">${d.rating}★</span></div>`).join('')}
          </div>
        `;
      } else {
        ratingChart.classList.remove('animate-pulse', 'bg-zinc-800/50', 'rounded-xl');
        ratingChart.innerHTML = '<p style="color:#52525b;font-size:14px;font-weight:500;text-align:center;padding-top:40px">No ratings for the selected period.</p>';
      }
    }

    // Most watched genres
    const genresContainer = document.getElementById('genres-container');
    if (genresContainer) {
      genresContainer.classList.remove('animate-pulse');
      const renderGenreList = (title, genres, bgColor, textColor) => {
        const max = genres.length > 0 ? Math.max(...genres.map(g => g.count)) : 1;
        return `
          <div class="space-y-3">
            <h4 class="text-[10px] font-black text-zinc-500 uppercase tracking-widest">${title}</h4>
            <div class="space-y-2">
              ${genres.length > 0 ? genres.map(g => {
                const pct = (g.count / max) * 100;
                return `
                  <div class="relative flex items-center justify-between px-3 py-2 bg-zinc-800/30 rounded-lg overflow-hidden">
                    <div class="absolute inset-0" style="width:${pct}%;background:${bgColor};pointer-events:none"></div>
                    <span class="relative text-xs font-bold text-zinc-300">${g.name}</span>
                    <span class="relative text-xs font-black" style="color:${textColor}">${g.count}</span>
                  </div>
                `;
              }).join('') : `<p class="text-xs text-zinc-600 italic">No data</p>`}
            </div>
          </div>
        `;
      };
      genresContainer.innerHTML =
        renderGenreList('Movies', data.top_movie_genres || [], 'rgba(14,165,233,0.1)', '#38bdf8') +
        renderGenreList('Shows', data.top_show_genres || [], 'rgba(168,85,247,0.1)', '#c084fc');
    }

    // Watch time breakdown
    const watchTimeBreakdown = document.getElementById('watch-time-breakdown');
    if (watchTimeBreakdown) {
      watchTimeBreakdown.classList.remove('animate-pulse');
      watchTimeBreakdown.innerHTML = [
        { label: 'Movies', value: data.movie_watch_minutes, textColor: '#38bdf8' },
        { label: 'Shows',  value: data.show_watch_minutes,  textColor: '#c084fc' },
      ].map(({ label, value, textColor }) => `
        <div class="flex items-center justify-between bg-zinc-800/40 rounded-xl px-4 py-3">
          <span class="text-sm font-bold text-zinc-300">${label}</span>
          <span style="color:${textColor}" class="font-black text-lg">${formatMinutes(value)}</span>
        </div>
      `).join('');
    }

    // Avg ratings
    const avgRatings = document.getElementById('avg-ratings');
    if (avgRatings) {
      avgRatings.classList.remove('animate-pulse');
      avgRatings.innerHTML = [
        { label: 'Movies', value: data.avg_movie_rating, textColor: '#38bdf8' },
        { label: 'Shows', value: data.avg_show_rating,   textColor: '#c084fc' },
      ].map(({ label, value, textColor }) => `
        <div class="flex items-center justify-between bg-zinc-800/40 rounded-xl px-4 py-3">
          <span class="text-sm font-bold text-zinc-300">${label}</span>
          ${value != null
            ? `<span class="flex items-center gap-1.5 font-black text-lg" style="color:${textColor}"><span class="text-sm text-yellow-400">★</span>${value.toFixed(1)}</span>`
            : `<span class="text-zinc-600 text-sm font-medium">No ratings</span>`
          }
        </div>
      `).join('');
    }

    // Weekday activity chart
    const weekdayChart = document.getElementById('weekday-chart');
    if (weekdayChart && data.weekday_activity) {
      weekdayChart.classList.remove('animate-pulse', 'bg-zinc-800/50', 'rounded-xl');
      const hasActivity = data.weekday_activity.some(d => d.avg > 0);
      if (hasActivity) {
        const maxAvg = Math.max(...data.weekday_activity.map(d => d.avg), 0.1);
        const peakDay = data.weekday_activity.reduce((a, b) => a.avg >= b.avg ? a : b).day;
        weekdayChart.style.display = 'flex';
        weekdayChart.style.gap = '6px';
        weekdayChart.style.alignItems = 'flex-end';
        weekdayChart.innerHTML = data.weekday_activity.map(d => {
          const pct = (d.avg / maxAvg) * 100;
          const isPeak = d.day === peakDay;
          const color = isPeak ? 'rgba(14,165,233,0.9)' : 'rgba(63,63,70,0.8)';
          return `
            <div style="flex:1;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:6px">
              <span style="font-size:10px;font-weight:700;color:${isPeak ? 'rgba(14,165,233,0.9)' : '#52525b'}">${d.avg > 0 ? d.avg.toFixed(1) : ''}</span>
              <div style="height:${Math.max(pct, 3)}%;width:100%;background:${color};border-radius:4px 4px 0 0" title="${d.day}: avg ${d.avg} items/week"></div>
              <span style="font-size:11px;font-weight:800;color:${isPeak ? '#e4e4e7' : '#71717a'};text-transform:uppercase;letter-spacing:.05em">${d.day}</span>
            </div>
          `;
        }).join('');
      } else {
        weekdayChart.style.display = '';
        weekdayChart.style.gap = '';
        weekdayChart.style.alignItems = '';
        weekdayChart.innerHTML = '<p style="color:#52525b;font-size:14px;font-weight:500;text-align:center;padding-top:40px">No watch history for the selected period.</p>';
      }
    }

    // Collection breakdown
    const collectionBreakdown = document.getElementById('collection-breakdown');
    if (collectionBreakdown) {
      collectionBreakdown.classList.remove('animate-pulse');
      collectionBreakdown.innerHTML = [
        { label: 'Movies Collected',   value: data.movies_collected.toLocaleString(),   textColor: '#38bdf8' },
        { label: 'Shows Collected',    value: data.shows_collected.toLocaleString(),    textColor: '#c084fc' },
        { label: 'Episodes Collected', value: data.episodes_collected.toLocaleString(), textColor: '#818cf8' },
      ].map(({ label, value, textColor }) => `
        <div class="flex items-center justify-between bg-zinc-800/40 rounded-xl px-4 py-3">
          <span class="text-sm font-bold text-zinc-300">${label}</span>
          <span style="color:${textColor}" class="font-black text-lg">${value}</span>
        </div>
      `).join('');
    }

    // Collection pie charts
    const pieContainer = document.getElementById('collection-pies');
    if (pieContainer) {
      const C = 2 * Math.PI * 38; // circumference for r=38

      function donut(pct, colorA, colorB, title, labelA, labelB, countA, countB) {
        const arc = Math.max(Math.min(pct / 100 * C, C - 1), 1);
        return `
          <div class="flex flex-col items-center gap-6">
            <p class="text-[10px] font-black text-zinc-500 uppercase tracking-widest text-center">${title}</p>
            <svg viewBox="0 0 100 100" width="80" height="80" style="transform:rotate(-90deg)">
              <circle cx="50" cy="50" r="38" fill="none" stroke="${colorB}" stroke-width="14"/>
              <circle cx="50" cy="50" r="38" fill="none" stroke="${colorA}" stroke-width="14"
                stroke-dasharray="${arc} ${C}" stroke-dashoffset="0"/>
            </svg>
            <div class="flex flex-col gap-1 w-full">
              <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-sm shrink-0" style="background:${colorA}"></span>
                <span class="text-[11px] font-bold text-zinc-500 flex-1">${labelA}</span>
                <span class="text-[11px] font-black text-zinc-800 dark:text-zinc-100">${countA.toLocaleString()}</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-sm shrink-0" style="background:${colorB}"></span>
                <span class="text-[11px] font-bold text-zinc-500 flex-1">${labelB}</span>
                <span class="text-[11px] font-black text-zinc-800 dark:text-zinc-100">${countB.toLocaleString()}</span>
              </div>
            </div>
          </div>
        `;
      }

      const totalColl = data.movies_collected + data.shows_collected;
      const moviesPct = totalColl > 0 ? data.movies_collected / totalColl * 100 : 0;
      const mwPct     = data.movies_collected > 0 ? data.movies_watched_collected / data.movies_collected * 100 : 0;
      const swPct     = data.shows_collected  > 0 ? data.shows_watched_collected  / data.shows_collected  * 100 : 0;

      pieContainer.classList.remove('animate-pulse');
      pieContainer.innerHTML =
        donut(moviesPct, 'rgba(14,165,233,0.85)', 'rgba(168,85,247,0.7)', 'Movies vs Shows', 'Movies',  'Shows',     data.movies_collected,         data.shows_collected) +
        donut(mwPct,     'rgba(34,197,94,0.85)',  'rgba(63,63,70,0.6)',   'Movies Watched',  'Watched', 'Unwatched', data.movies_watched_collected, data.movies_unwatched_collected) +
        donut(swPct,     'rgba(34,197,94,0.85)',  'rgba(63,63,70,0.6)',   'Shows Watched',   'Watched', 'Unwatched', data.shows_watched_collected,  data.shows_unwatched_collected);
    }
    renderTopStats(data);
  } // end renderStats

  // ── Most Watched: top titles, networks and people (#124) ──────────────────
  function renderTopStats(data) {
    const section = document.getElementById('top-stats');
    if (!section) return;
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    // Local artwork paths require Astro's proxy just like the detail and
    // collection cards do. This covers both uploaded artwork and Jellyfin
    // covers, whose /media URLs must not be requested from the frontend app.
    const posterUrl = (path) => {
      if (!path) return null;
      if (path.startsWith('/media/')) return `/api/proxy${path}`;
      if (path.startsWith('http://') || path.startsWith('https://')) {
        const tmdb = /image\.tmdb\.org\/t\/p\/([^/]+)(\/.+)$/.exec(path);
        if (tmdb) return `/api/proxy/media/image/${tmdb[1]}${tmdb[2]}`;
        const tvdb = /artworks\.thetvdb\.com(\/.+)$/.exec(path);
        if (tvdb) return `/api/proxy/media/image/tvdb${tvdb[1]}`;
        return path;
      }
      return `/api/proxy/media/image/w500${path.startsWith('/') ? path : '/' + path}`;
    };
    const fmtH = (min) => { const h = Math.floor(min / 60); const m = min % 60; return h > 0 ? (m > 0 ? `${h}h ${m}m` : `${h}h`) : `${m}m`; };
    const card = (id, has) => { const el = document.getElementById(id + '-card'); if (el) el.style.display = has ? '' : 'none'; return has; };

    const posters = (items) => (items || []).filter(it => it.title).map(it => `
      <a href="${it.episodes != null ? '/show/' + it.tmdb_id : '/media/movie/' + it.tmdb_id}" class="group block">
        <div class="aspect-[2/3] rounded-xl overflow-hidden bg-zinc-800">
          ${posterUrl(it.poster_path) ? `<img src="${esc(posterUrl(it.poster_path))}" alt="${esc(it.title)}" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform">` : ''}
        </div>
        <div class="text-xs text-zinc-300 font-semibold mt-1.5 truncate">${esc(it.title)}</div>
        <div class="text-[11px] text-zinc-500">${it.plays} play${it.plays === 1 ? '' : 's'} · ${fmtH(it.minutes || 0)}</div>
      </a>`).join('');
    document.getElementById('top-shows').innerHTML = posters(data.top_shows);
    document.getElementById('top-movies').innerHTML = posters(data.top_movies);

    document.getElementById('top-networks').innerHTML = (data.top_networks || []).map(n => `
      <div class="flex items-center gap-2 bg-white/90 rounded-lg px-3 py-2" title="${esc(n.name)} · ${n.plays} plays">
        ${n.logo_path ? `<img src="https://image.tmdb.org/t/p/w92${esc(n.logo_path)}" alt="${esc(n.name)}" class="h-5 object-contain">` : `<span class="text-sm font-bold text-zinc-800">${esc(n.name)}</span>`}
        <span class="text-xs font-semibold text-zinc-500">${n.plays}</span>
      </div>`).join('');

    const chips = (items, linked) => (items || []).map(p => {
      const tag = linked ? 'a' : 'span';
      const href = linked ? ` href="/person/${p.id}"` : '';
      return `
      <${tag}${href} class="inline-flex items-center gap-1.5 bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-1.5${linked ? ' hover:border-blue-500/50 hover:bg-zinc-800/60 transition-colors' : ''}" title="${esc(p.name)} · ${p.titles} title${p.titles === 1 ? '' : 's'} · ${p.plays} play${p.plays === 1 ? '' : 's'}">
        <span class="text-sm font-semibold text-zinc-200">${esc(p.name)}</span>
        <span class="text-[11px] font-semibold text-blue-400 bg-blue-500/10 rounded-full px-1.5 py-0.5">${p.titles}</span>
      </${tag}>`;
    }).join('');
    const people = data.top_people || {};
    document.getElementById('top-actors').innerHTML = chips(people.actors, true);
    document.getElementById('top-directors').innerHTML = chips(people.directors, true);
    document.getElementById('top-writers').innerHTML = chips(people.writers, true);
    document.getElementById('top-studios').innerHTML = chips(people.studios, false);

    const any = [
      card('top-shows', (data.top_shows || []).length > 0),
      card('top-movies', (data.top_movies || []).length > 0),
      card('top-networks', (data.top_networks || []).length > 0),
      card('top-actors', (people.actors || []).length > 0),
      card('top-directors', (people.directors || []).length > 0),
      card('top-writers', (people.writers || []).length > 0),
      card('top-studios', (people.studios || []).length > 0),
    ].some(Boolean);
    section.style.display = any ? '' : 'none';
  }

  function fmtGameTime(minutes) {
    const m = Number(minutes || 0), h = Math.floor(m / 60), r = m % 60;
    return h ? (r ? h + 'h ' + r + 'm' : h + 'h') : r + 'm';
  }

  function renderGameStats(games) {
    const section = document.getElementById('game-stats');
    if (!section || !games || !games.total_games) return;
    section.style.display = '';
    const set = (id, value) => { const el = document.getElementById(id); if (el) el.textContent = value; };
    set('game-count', Number(games.total_games).toLocaleString());
    set('game-time', fmtGameTime(games.total_playtime_minutes));
    set('game-plays', Number(games.total_play_count || 0).toLocaleString());
    set('game-achievements', games.completion_percent == null ? '—' : games.completion_percent + '%');
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
    const platforms = document.getElementById('game-platforms');
    if (platforms) platforms.innerHTML = (games.platforms || []).map(p =>
      '<div class="flex items-center gap-3 py-2 border-b border-zinc-800 last:border-0"><span class="font-bold text-zinc-200 flex-1">' + esc(p.platform) + '</span><span class="text-xs text-zinc-500">' + p.games + ' games</span><span class="text-xs font-bold text-zinc-300">' + fmtGameTime(p.playtime_minutes) + '</span></div>'
    ).join('');
    const cards = document.getElementById('top-games');
    if (cards) cards.innerHTML = (games.top_games || []).map(g =>
      '<a href="/game/' + g.id + '" class="group block min-w-0"><div class="aspect-[2/3] rounded-xl overflow-hidden bg-zinc-800 border border-zinc-800 group-hover:border-zinc-600 transition">' +
      (g.cover_path ? '<img src="' + esc(g.cover_path) + '" alt="' + esc(g.title) + '" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform">' : '<div class="w-full h-full flex items-center justify-center p-3 text-xs text-center text-zinc-500">' + esc(g.title) + '</div>') +
      '</div><div class="text-xs text-zinc-300 font-semibold mt-1.5 truncate">' + esc(g.title) + '</div><div class="text-[11px] text-zinc-500">' + fmtGameTime(g.playtime_minutes) + ' · ' + Number(g.play_count || 0).toLocaleString() + ' plays' + (g.completion_percent != null ? ' · ' + g.completion_percent + '%' : '') + '</div></a>'
    ).join('');
  }

  // ── Fetch ──────────────────────────────────────────────────────────────────
  async function loadStats(since, until) {
    setLoading(true);
    try {
      const params = new URLSearchParams();
      if (since) params.set('since', since);
      if (until) params.set('until', until);
      const qs = params.toString();
      const res = await fetch(`/api/proxy/profile/${userId}/stats${qs ? '?' + qs : ''}`, {
        headers: token ? { Authorization: `Bearer ${token}` } : {},
      });
      if (!res.ok) { setLoading(false); return; }
      const data = await res.json();
      renderStats(data, since, until);
      renderGameStats(data.games);
    } catch { /* silent */ }
    setLoading(false);
  }

  // ── Refresh ────────────────────────────────────────────────────────────────
  function refresh() {
    const { since, until, label } = computeRange(currentPeriod);
    const custom=document.getElementById('custom-range');
    const weekdayTitle=document.getElementById('weekday-chart-title');
    if(custom) {
      custom.classList.toggle('hidden', currentPeriod!=='custom');
      custom.classList.toggle('flex', currentPeriod==='custom');
    }
    if(weekdayTitle) {
      const isWeekly=currentPeriod==='week'||currentPeriod==='lastweek'||currentPeriod==='last7';
      weekdayTitle.textContent=isWeekly?'Activity by Day of Week':'Average Activity by Day of Week';
    }
    loadStats(since,until);
  }

  // ── Event listeners ────────────────────────────────────────────────────────
  document.getElementById('period-select').addEventListener('change', e => {
    currentPeriod=e.target.value;
    if(currentPeriod==='custom') {
      const today=new Date();
      const since=new Date(today); since.setDate(today.getDate()-29);
      document.getElementById('custom-since').value=_fmt(since);
      document.getElementById('custom-until').value=_fmt(today);
    }
    refresh();
  });
  document.getElementById('custom-apply').addEventListener('click',refresh);

  refresh();
</script>
