---
import Base from "../../layouts/Base.astro";
export const prerender = false;

const { id } = Astro.params;
const { token, user: currentUser } = Astro.locals;

// Lightweight privacy pre-check — reuses the same endpoint, only reads the status code.
// If 403/404, we show the appropriate error shell without loading any stats.
let accessError = "";

try {
  const res = await fetch(
    `http://localhost:${import.meta.env.BACKEND_PORT ?? "7331"}/profile/${id}`,
    token ? { headers: { Authorization: `Bearer ${token}` } } : {}
  );
  if (res.status === 404) accessError = "Benutzer nicht gefunden.";
  else if (res.status === 403) accessError = "Dieses Profil ist privat.";
  else if (!res.ok) accessError = "Profil konnte nicht geladen werden.";
} catch {
  accessError = "Failed to load profile.";
}

const isOwnStats = currentUser && String(currentUser.id) === String(id);
---


<Base title="Statistiken">
  {accessError ? (
    <div class="max-w-md mx-auto mt-20 text-center">
      <div class="bg-zinc-900/50 border border-zinc-800 p-10 rounded-3xl">
        <div class="w-20 h-20 bg-zinc-800 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-500"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h2 class="text-2xl font-black text-zinc-100 mb-2">Zugriff eingeschränkt</h2>
        <p class="text-zinc-400 font-medium mb-8">{accessError}</p>
        <a href="/" class="px-6 py-3 bg-sky-600 hover:bg-sky-500 text-white font-black rounded-xl transition-all inline-block">Zur Startseite</a>
      </div>
    </div>
  ) : (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 md:py-10 stats-page">

      <header class="stats-hero">
        <div class="stats-toolbar">
          <div class="toolbar-left">
            <a href={'/profile/' + id} class="back-link">← Profil</a>
            <div><div class="hero-kicker">SCROB · STATISTIKEN</div></div>
          </div>
        </div>
      </header>

      <div class="stats-controls">
        <nav id="stats-tabs" class="stats-tabs" aria-label="Statistikkategorie">
        <div class="stats-tab-options">
          <button type="button" class="stats-tab active" data-stats-tab="media" aria-selected="true">Filme &amp; Serien</button>
          <button type="button" class="stats-tab" data-stats-tab="gaming" aria-selected="false">Spiele</button>
        </div>
      </nav>
        <div class="period-control">
        <select id="period-select" aria-label="Zeitraum">
          <option value="all">Gesamter Zeitraum</option><option value="today">Heute</option><option value="yesterday">Gestern</option>
          <option value="week">Diese Woche</option><option value="lastweek">Letzte Woche</option><option value="month">Dieser Monat</option>
          <option value="lastmonth">Letzter Monat</option><option value="year">Dieses Jahr</option><option value="lastyear">Letztes Jahr</option>
          <option value="last7">Letzte 7 Tage</option><option value="last30">Letzte 30 Tage</option><option value="last90">Letzte 90 Tage</option>
          <option value="last365">Letzte 365 Tage</option><option value="custom">Benutzerdefiniert …</option>
        </select>
        <div id="custom-range" class="hidden items-center gap-2"><input id="custom-since" type="date" aria-label="Von"><span>–</span><input id="custom-until" type="date" aria-label="Bis"><button id="custom-apply">Anwenden</button></div>
      </div>
      </div>
      <main id="stats-content">
        <section id="summary-row" class="kpi-grid overview-kpis">
          {[...Array(4)].map(() => <div class="kpi-card skeleton-card animate-pulse"><div class="skeleton h-9 w-20"></div><div class="skeleton h-3 w-28 mt-3"></div></div>)}
        </section>


        <section class="feature-grid">
          <div class="panel activity-panel hero-panel">
            <div class="panel-heading">
              <div><p class="eyebrow">Aktivität</p></div>
              <span class="panel-badge">Filme + Episoden</span>
            </div>
            <div id="activity-chart" class="chart-lg animate-pulse"></div>
          </div>
          <div class="panel time-panel">
            <div class="panel-heading"><div><p class="eyebrow">Zeit</p></div></div>
            <div id="watch-time-breakdown" class="metric-stack animate-pulse"><div class="skeleton h-12"></div><div class="skeleton h-12"></div></div>
            <div id="watch-time-chart" class="chart-sm animate-pulse"></div>
          </div>
        </section>

        <section class="section-block taste-section">
          <div class="section-title"><div><p class="eyebrow">Dein Geschmack</p></div></div>
          <div class="taste-grid">
            <div class="panel"><h3>Meistgesehene Genres</h3><div id="genres-container" class="genre-columns animate-pulse"><div class="skeleton h-40"></div><div class="skeleton h-40"></div></div></div>
            <div class="panel">
              <h3>Bewertungsverteilung</h3>
              <div id="avg-ratings" class="metric-stack rating-averages animate-pulse"><div class="skeleton h-12"></div><div class="skeleton h-12"></div></div>
              <div id="rating-chart" class="chart-md animate-pulse"></div>
            </div>
          </div>
          <div class="panel weekday-panel">
            <h3 id="weekday-chart-title">Durchschnittliche Aktivität nach Wochentag</h3>
            <div id="weekday-chart" class="chart-md animate-pulse"></div>
          </div>
        </section>

        <section id="game-stats" class="section-block game-section" style="display:none">
          <section id="game-summary-row" class="kpi-grid overview-kpis">
            {[...Array(4)].map(() => <div class="kpi-card skeleton-card animate-pulse"><div class="skeleton h-9 w-20"></div><div class="skeleton h-3 w-28 mt-3"></div></div>)}
          </section>

          <section class="top-grid game-top-grid">
            <div class="panel poster-panel" id="top-games-card">
              <h3>Meistgespielt</h3>
              <div id="top-games" class="poster-grid"></div>
            </div>
            <div class="panel poster-panel" id="game-history-card">
              <h3>Letzte Aktivitäten</h3>
              <div id="game-history" class="poster-grid"></div>
            </div>
          </section>

          <section class="section-block taste-section">
            <div class="section-title">
              <div><p class="eyebrow">Aktivität</p><h2>Wann du spielst</h2><p class="section-copy">Deine Spielaktivität im ausgewählten Zeitraum.</p></div>
            </div>
            <div class="taste-grid game-taste-grid">
              <div class="panel" style="grid-column:1 / -1">
                <h3 id="game-weekday-title">Aktivität nach Wochentag</h3>
                <div id="game-weekday-chart" class="chart-md"></div>
              </div>
            </div>
          </section>
        </section>

        <section id="top-stats" class="section-block" style="display:none">
          <div class="section-title"><div><p class="eyebrow">Favoriten</p></div></div>
          <div class="top-grid">
            <div class="panel poster-panel" id="top-shows-card"><h3>Top-Serien</h3><div id="top-shows" class="poster-grid"></div></div>
            <div class="panel poster-panel" id="top-movies-card"><h3>Top-Filme</h3><div id="top-movies" class="poster-grid"></div></div>
            <div class="panel" id="top-networks-card"><h3>Lieblingssender</h3><div id="top-networks" class="chip-grid"></div></div>
            <div class="panel" id="top-actors-card"><h3>Meistgesehene Schauspieler</h3><div id="top-actors" class="chip-grid"></div></div>
            <div class="panel" id="top-directors-card"><h3>Lieblingsregisseure</h3><div id="top-directors" class="chip-grid"></div></div>
            <div class="panel" id="top-writers-card"><h3>Lieblingsautoren</h3><div id="top-writers" class="chip-grid"></div></div>
            <div class="panel" id="top-studios-card"><h3>Lieblingsstudios</h3><div id="top-studios" class="chip-grid"></div></div>
          </div>
        </section>

        <section class="section-block">
          <div class="section-title"><div><p class="eyebrow">Mediathek</p></div></div>
          <div class="collection-grid">
            <div class="panel"><h3>Sammlungsübersicht</h3><div id="collection-breakdown" class="metric-stack animate-pulse"><div class="skeleton h-12"></div><div class="skeleton h-12"></div><div class="skeleton h-12"></div></div></div>
            <div class="panel collection-panel"><h3>Watched vs unwatched</h3><div id="collection-pies" class="pie-grid animate-pulse">{[...Array(3)].map(() => <div class="skeleton rounded-full w-24 h-24 mx-auto"></div>)}</div></div>
          </div>
        </section>

        <footer class="stats-footer"><span>SCROB · STATISTIKEN</span><span>Basierend auf deinem Verlauf</span></footer>
      </main>
    </div>
  )}
</Base>


<style>
